@model CreateProductImageDto
@{
    ViewData["Title"] = "Yeni Görsel";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bg-light rounded p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="mb-0"><i class="fa fa-image text-primary me-2"></i>Yeni Görsel Ekle</h5>
                    <a asp-area="Admin" asp-controller="ProductImage" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"></i>Geri
                    </a>
                </div>

                <form asp-area="Admin" asp-controller="ProductImage" asp-action="CreateProductImage" method="post">
                    <div class="mb-3">
                        <label asp-for="Product" class="form-label">İlan</label>
                        <select asp-for="Product" asp-items="ViewBag.Products" class="form-select" required>
                            <option value="">-- İlan seçin --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label">Görsel URL</label>
                        <input asp-for="ImageUrl" id="imageUrl" class="form-control" placeholder="https://..." required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="SortOrder" class="form-label">Sıra</label>
                        <input asp-for="SortOrder" type="number" min="0" class="form-control" />
                        <small class="text-muted">Slider'da kaçıncı sırada görüneceği (1 = ilk)</small>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i>Kaydet
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bg-light rounded p-4 h-100">
                <h6 class="mb-3"><i class="fa fa-eye text-primary me-2"></i>Önizleme</h6>
                <div class="rounded overflow-hidden bg-white d-flex align-items-center justify-content-center" style="aspect-ratio: 4 / 3;">
                    <img id="preview" src="" alt="" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                    <span id="previewEmpty" class="text-muted"><i class="fa fa-image fa-2x d-block mb-2 text-center"></i>URL girince burada görünür</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>(function () {
        var input = document.getElementById('imageUrl');
        var img = document.getElementById('preview');
        var empty = document.getElementById('previewEmpty');
        function show() {
            var url = input.value.trim();
            img.style.display = url ? 'block' : 'none';
            empty.style.display = url ? 'none' : 'block';
            img.src = url;
        }
        img.onerror = function () { img.style.display = 'none'; empty.style.display = 'block'; };
        input.addEventListener('input', show);
        show();
    })();</script>
