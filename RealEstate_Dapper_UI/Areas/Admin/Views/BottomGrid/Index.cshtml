@model List<ResultBottomGridDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Hızlı Erişim Kartları";
}

<style>
    .bg-grid-card {
        height: 100%;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 26px 24px;
        position: relative;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .bg-grid-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 36px -20px rgba(16, 24, 40, .3);
            border-color: transparent;
        }

    .bg-grid-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: var(--primary-soft);
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 22px;
        margin-bottom: 18px;
    }

    .bg-grid-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 8px;
    }

    .bg-grid-desc {
        color: var(--muted);
        font-size: .9rem;
        line-height: 1.65;
        margin-bottom: 0;
    }

    .bg-grid-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        font-size: .78rem;
        color: var(--muted);
    }

        .bg-grid-meta code {
            background: var(--primary-soft);
            color: var(--primary);
            padding: 2px 8px;
            border-radius: 6px;
            font-size: .75rem;
        }

    .bg-grid-actions {
        position: absolute;
        top: 18px;
        right: 18px;
        display: flex;
        gap: 6px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-grid;
        place-items: center;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--muted);
        transition: all .15s ease;
    }

        .action-btn.edit:hover {
            background: var(--primary-soft);
            color: var(--primary);
            border-color: transparent;
        }

        .action-btn.delete:hover {
            background: rgba(239, 68, 68, .1);
            color: #dc2626;
            border-color: transparent;
        }

    .add-card {
        height: 100%;
        min-height: 230px;
        border: 2px dashed var(--line);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--muted);
        text-decoration: none;
        transition: all .2s ease;
    }

        .add-card:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-soft);
        }

        .add-card i {
            font-size: 24px;
        }

    .empty-state {
        text-align: center;
        padding: 56px 20px;
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        background: var(--primary-soft);
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 28px;
        margin: 0 auto 16px;
    }

    .delete-modal .modal-content {
        border: none;
        border-radius: 20px;
        box-shadow: 0 24px 60px rgba(16, 24, 40, .2);
    }

    .delete-modal .modal-body {
        padding: 32px 28px 8px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(239, 68, 68, .1);
        color: #dc2626;
        display: grid;
        place-items: center;
        font-size: 26px;
        margin: 0 auto 18px;
        box-shadow: 0 0 0 10px rgba(239, 68, 68, .05);
    }

    .delete-modal h5 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .delete-modal .delete-text {
        color: var(--muted);
        font-size: .92rem;
        margin-bottom: 0;
    }

    .delete-modal .delete-name {
        color: var(--text);
        font-weight: 600;
    }

    .delete-modal .modal-footer {
        border: none;
        padding: 20px 28px 28px;
        gap: 10px;
    }

        .delete-modal .modal-footer .btn {
            flex: 1;
            height: 44px;
            border-radius: 12px;
            font-weight: 600;
        }

    .delete-modal .btn-danger {
        background: #dc2626;
        border-color: #dc2626;
    }

        .delete-modal .btn-danger:hover {
            background: #b91c1c;
            border-color: #b91c1c;
        }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Hızlı Erişim Kartları</h4>
            <p class="mb-0" style="color: var(--muted);">Ana sayfada "Ev Satın Al, Ev Kirala" gibi yan yana görünen kutuları buradan yönetebilirsiniz.</p>
        </div>
        <a asp-area="Admin" asp-controller="BottomGrid" asp-action="CreateBottomGrid" class="btn btn-primary px-4">
            <i class="fa fa-plus me-2"></i>Yeni Kart
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="bg-grid-card">
                        <div class="bg-grid-actions">
                            <a asp-area="Admin" asp-controller="BottomGrid" asp-action="UpdateBottomGrid" asp-route-id="@item.BottomGridId"
                               class="action-btn edit" title="Düzenle">
                                <i class="fa fa-pen"></i>
                            </a>
                            <button type="button" class="action-btn delete" title="Sil"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-name="@item.Title"
                                    data-url="@Url.Action("DeleteBottomGrid", "BottomGrid", new { area = "Admin", id = item.BottomGridId })">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>

                        <div class="bg-grid-icon"><i class="@item.Icon"></i></div>
                        <div class="bg-grid-title">@item.Title</div>
                        <p class="bg-grid-desc">@item.Description</p>

                        <div class="bg-grid-meta">
                            <span>#@item.BottomGridId</span>
                            <span>·</span>
                            <code>@item.Icon</code>
                        </div>
                    </div>
                </div>
            }

            <div class="col-md-6 col-xl-4">
                <a asp-area="Admin" asp-controller="BottomGrid" asp-action="CreateBottomGrid" class="add-card">
                    <i class="fa fa-plus-circle"></i>
                    <span class="fw-semibold">Yeni kart ekle</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="bg-light rounded p-4">
            <div class="empty-state">
                <div class="empty-icon"><i class="fa fa-th-large"></i></div>
                <h5 class="fw-bold mb-1">Henüz kart yok</h5>
                <p class="mb-4" style="color: var(--muted);">Ana sayfadaki hızlı erişim bölümü için ilk kartı ekleyin.</p>
                <a asp-area="Admin" asp-controller="BottomGrid" asp-action="CreateBottomGrid" class="btn btn-primary px-4">
                    <i class="fa fa-plus me-2"></i>Kart Ekle
                </a>
            </div>
        </div>
    }
</div>

<!-- Silme modalı -->
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon"><i class="fa fa-trash-alt"></i></div>
                <h5 id="deleteModalLabel">Kartı sil</h5>
                <p class="delete-text">
                    <span class="delete-name" id="deleteCardName"></span> kartını silmek üzeresiniz.
                    Kart ana sayfadan kaldırılacak. Bu işlem geri alınamaz.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Vazgeç</button>
                <form id="deleteForm" method="post" class="d-flex flex-fill m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa fa-trash-alt me-2"></i>Evet, sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("deleteModal").addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            document.getElementById("deleteCardName").textContent = "\"" + button.getAttribute("data-name") + "\"";
            document.getElementById("deleteForm").setAttribute("action", button.getAttribute("data-url"));
        });
    });
</script>