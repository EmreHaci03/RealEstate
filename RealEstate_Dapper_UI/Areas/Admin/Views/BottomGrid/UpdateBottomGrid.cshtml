@model UpdateBottomGridDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Kartı Güncelle";

    var icons = new[] { "fa fa-home", "fa fa-key", "fa fa-building", "fa fa-map-marker", "fa fa-search", "fa fa-handshake-o", "fa fa-money", "fa fa-users", "fa fa-star", "fa fa-shield", "fa fa-calculator", "fa fa-phone" };
}

<style>
    .bg-preview-label {
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .bg-preview {
        position: sticky;
        top: 90px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 28px 24px;
        text-align: center;
        box-shadow: 0 10px 30px -18px rgba(16, 24, 40, .25);
    }

    .bg-preview-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: var(--primary-soft);
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 26px;
        margin: 0 auto 18px;
    }

    .bg-preview-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 8px;
    }

    .bg-preview-desc {
        color: var(--muted);
        font-size: .9rem;
        line-height: 1.65;
        margin-bottom: 14px;
    }

    .bg-preview-more {
        font-size: .85rem;
        font-weight: 600;
        color: var(--primary);
    }

    .icon-picker {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(46px, 1fr));
        gap: 8px;
        margin-top: 10px;
    }

    .icon-option {
        height: 46px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--muted);
        display: grid;
        place-items: center;
        font-size: 18px;
        cursor: pointer;
        transition: all .15s ease;
    }

        .icon-option:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .icon-option.selected {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

    .char-count {
        font-size: .78rem;
        color: var(--muted);
    }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Kartı Güncelle</h4>
            <p class="mb-0" style="color: var(--muted);">Değişiklikleri sağda, ana sayfadaki görünümüyle anında görün.</p>
        </div>
        <a asp-area="Admin" asp-controller="BottomGrid" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Listeye Dön
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bg-light rounded p-4 h-100">
                <h6 class="mb-4">Kart Bilgileri</h6>

                <form asp-area="Admin" asp-controller="BottomGrid" asp-action="UpdateBottomGrid" method="post">
                    <input type="hidden" asp-for="BottomGridId" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label">Başlık</label>
                            <input asp-for="Title" class="form-control" id="cardTitle" maxlength="100" required />
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                                <span class="char-count" id="descCount">0 / 250</span>
                            </div>
                            <textarea asp-for="Description" class="form-control" id="cardDesc" rows="3" maxlength="250" required></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Icon" class="form-label">İkon</label>
                            <input asp-for="Icon" class="form-control" id="cardIcon" required />
                            <div class="form-text">Aşağıdan seçin ya da Font Awesome sınıfını elle yazın.</div>
                            <div class="icon-picker">
                                @foreach (var icon in icons)
                                {
                                    <button type="button" class="icon-option" data-icon="@icon" title="@icon">
                                        <i class="@icon"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa fa-save me-2"></i>Değişiklikleri Kaydet
                        </button>
                        <a asp-area="Admin" asp-controller="BottomGrid" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bg-preview-label"><i class="fa fa-eye me-1"></i>Ana Sayfada Böyle Görünecek</div>
            <div class="bg-preview">
                <div class="bg-preview-icon"><i id="pvIcon" class="fa fa-question"></i></div>
                <div class="bg-preview-title" id="pvTitle">Kart başlığı</div>
                <p class="bg-preview-desc" id="pvDesc"></p>
                <span class="bg-preview-more">Devamı <i class="fa fa-long-arrow-right ms-1"></i></span>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var titleInput = document.getElementById("cardTitle");
        var descInput = document.getElementById("cardDesc");
        var iconInput = document.getElementById("cardIcon");
        var options = document.querySelectorAll(".icon-option");

        function update() {
            document.getElementById("pvTitle").textContent = titleInput.value.trim() || "Kart başlığı";
            document.getElementById("pvDesc").textContent = descInput.value.trim();
            document.getElementById("descCount").textContent = descInput.value.length + " / 250";

            var icon = iconInput.value.trim();
            document.getElementById("pvIcon").className = icon || "fa fa-question";

            options.forEach(function (btn) {
                btn.classList.toggle("selected", btn.getAttribute("data-icon") === icon);
            });
        }

        options.forEach(function (btn) {
            btn.addEventListener("click", function () {
                iconInput.value = this.getAttribute("data-icon");
                update();
            });
        });

        [titleInput, descInput, iconInput].forEach(function (el) {
            el.addEventListener("input", update);
        });

        update();
    });
</script>