@model List<ResultSocialMediaDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sosyal Medya";

    // Sitedeki FA4 ikonunu admin panelindeki FA5 marka ikonuna çevirir (sadece görüntüleme için)
    string AdminIcon(string icon)
    {
        if (string.IsNullOrWhiteSpace(icon)) return "fas fa-link";
        return icon.Replace("fa fa-", "fab fa-").Replace("youtube-play", "youtube");
    }

    string BrandColor(string icon)
    {
        icon = icon?.ToLower() ?? "";
        if (icon.Contains("instagram")) return "#E4405F";
        if (icon.Contains("facebook")) return "#1877F2";
        if (icon.Contains("twitter")) return "#111827";
        if (icon.Contains("linkedin")) return "#0A66C2";
        if (icon.Contains("youtube")) return "#FF0000";
        if (icon.Contains("whatsapp")) return "#25D366";
        if (icon.Contains("tiktok")) return "#000000";
        if (icon.Contains("pinterest")) return "#E60023";
        return "#4f46e5";
    }
}

<style>
    .sm-card {
        height: 100%;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px;
        position: relative;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .sm-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 36px -20px rgba(16, 24, 40, .3);
            border-color: transparent;
        }

    .sm-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        font-size: 24px;
        color: #fff;
        flex-shrink: 0;
    }

    .sm-body {
        flex: 1;
        min-width: 0;
        padding-right: 76px;
    }

    .sm-name {
        font-weight: 700;
        color: var(--text);
        font-size: 1rem;
    }

    .sm-url {
        font-size: .82rem;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        text-decoration: none;
        margin-top: 2px;
    }

        .sm-url:hover {
            color: var(--primary);
        }

    .sm-actions {
        position: absolute;
        top: 50%;
        right: 18px;
        transform: translateY(-50%);
        display: flex;
        gap: 6px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-grid;
        place-items: center;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--muted);
        transition: all .15s ease;
    }

        .action-btn.edit:hover {
            background: var(--primary-soft);
            color: var(--primary);
            border-color: transparent;
        }

        .action-btn.delete:hover {
            background: rgba(239, 68, 68, .1);
            color: #dc2626;
            border-color: transparent;
        }

    .footer-preview {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 18px 22px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

        .footer-preview span.label {
            font-weight: 600;
            color: var(--text);
            margin-right: 6px;
        }

        .footer-preview a {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            border: 1px solid var(--line);
            color: var(--muted);
            text-decoration: none;
            transition: all .2s ease;
        }

            .footer-preview a:hover {
                color: #fff;
                border-color: transparent;
                transform: translateY(-2px);
            }

    .add-card {
        height: 100%;
        min-height: 100px;
        border: 2px dashed var(--line);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--muted);
        text-decoration: none;
        transition: all .2s ease;
    }

        .add-card:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-soft);
        }

    .empty-state {
        text-align: center;
        padding: 56px 20px;
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        background: var(--primary-soft);
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 28px;
        margin: 0 auto 16px;
    }

    .section-label {
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .delete-modal .modal-content {
        border: none;
        border-radius: 20px;
        box-shadow: 0 24px 60px rgba(16, 24, 40, .2);
    }

    .delete-modal .modal-body {
        padding: 32px 28px 8px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(239, 68, 68, .1);
        color: #dc2626;
        display: grid;
        place-items: center;
        font-size: 26px;
        margin: 0 auto 18px;
        box-shadow: 0 0 0 10px rgba(239, 68, 68, .05);
    }

    .delete-modal h5 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .delete-modal .delete-text {
        color: var(--muted);
        font-size: .92rem;
        margin-bottom: 0;
    }

    .delete-modal .delete-name {
        color: var(--text);
        font-weight: 600;
    }

    .delete-modal .modal-footer {
        border: none;
        padding: 20px 28px 28px;
        gap: 10px;
    }

        .delete-modal .modal-footer .btn {
            flex: 1;
            height: 44px;
            border-radius: 12px;
            font-weight: 600;
        }

    .delete-modal .btn-danger {
        background: #dc2626;
        border-color: #dc2626;
    }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Sosyal Medya</h4>
            <p class="mb-0" style="color: var(--muted);">Sitenin footer'ında görünen sosyal medya hesaplarını buradan yönetebilirsiniz.</p>
        </div>
        <a asp-area="Admin" asp-controller="SocialMedia" asp-action="CreateSocialMedia" class="btn btn-primary px-4">
            <i class="fa fa-plus me-2"></i>Yeni Hesap
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="section-label"><i class="fa fa-eye me-1"></i>Footer'da Böyle Görünüyor</div>
        <div class="footer-preview mb-4">
            <span class="label">Bizi takip edin</span>
            @foreach (var item in Model)
            {
                <a href="@item.SocialMediaUrl" target="_blank" rel="noopener" title="@item.Name"
                   onmouseover="this.style.background='@BrandColor(item.Icon)'" onmouseout="this.style.background=''">
                    <i class="@AdminIcon(item.Icon)"></i>
                </a>
            }
        </div>

        <div class="section-label">Hesaplar</div>
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="sm-card">
                        <div class="sm-icon" style="background: @BrandColor(item.Icon);">
                            <i class="@AdminIcon(item.Icon)"></i>
                        </div>
                        <div class="sm-body">
                            <div class="sm-name">@item.Name</div>
                            <a class="sm-url" href="@item.SocialMediaUrl" target="_blank" rel="noopener">@item.SocialMediaUrl</a>
                        </div>
                        <div class="sm-actions">
                            <a asp-area="Admin" asp-controller="SocialMedia" asp-action="UpdateSocialMedia" asp-route-id="@item.SocialMediaId"
                               class="action-btn edit" title="Düzenle">
                                <i class="fa fa-pen"></i>
                            </a>
                            <button type="button" class="action-btn delete" title="Sil"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-name="@item.Name"
                                    data-url="@Url.Action("DeleteSocialMedia", "SocialMedia", new { area = "Admin", id = item.SocialMediaId })">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="col-md-6 col-xl-4">
                <a asp-area="Admin" asp-controller="SocialMedia" asp-action="CreateSocialMedia" class="add-card">
                    <i class="fa fa-plus-circle"></i>
                    <span class="fw-semibold">Yeni hesap ekle</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="bg-light rounded p-4">
            <div class="empty-state">
                <div class="empty-icon"><i class="fa fa-share-alt"></i></div>
                <h5 class="fw-bold mb-1">Henüz sosyal medya hesabı yok</h5>
                <p class="mb-4" style="color: var(--muted);">Footer'da görünecek ilk hesabı ekleyin.</p>
                <a asp-area="Admin" asp-controller="SocialMedia" asp-action="CreateSocialMedia" class="btn btn-primary px-4">
                    <i class="fa fa-plus me-2"></i>Hesap Ekle
                </a>
            </div>
        </div>
    }
</div>

<!-- Silme modalı -->
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon"><i class="fa fa-trash-alt"></i></div>
                <h5 id="deleteModalLabel">Hesabı sil</h5>
                <p class="delete-text">
                    <span class="delete-name" id="deleteAccountName"></span> hesabını silmek üzeresiniz.
                    Footer'dan kaldırılacak. Bu işlem geri alınamaz.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Vazgeç</button>
                <form id="deleteForm" method="post" class="d-flex flex-fill m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa fa-trash-alt me-2"></i>Evet, sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("deleteModal").addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            document.getElementById("deleteAccountName").textContent = "\"" + button.getAttribute("data-name") + "\"";
            document.getElementById("deleteForm").setAttribute("action", button.getAttribute("data-url"));
        });
    });
</script>