@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Günaydın" : hour < 18 ? "İyi günler" : "İyi akşamlar";
    var today = DateTime.Now.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"));
}

<style>
    .db-hero {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 55%, #818cf8 100%);
        border-radius: 20px;
        padding: 28px 30px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .db-hero::before {
            content: "";
            position: absolute;
            right: -60px;
            top: -60px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .1);
        }

        .db-hero::after {
            content: "";
            position: absolute;
            right: 80px;
            bottom: -80px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .07);
        }

        .db-hero h3 {
            color: #fff;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .db-hero p {
            color: rgba(255, 255, 255, .85);
            margin: 0;
        }

    .db-hero-date {
        font-size: .85rem;
        color: rgba(255, 255, 255, .75);
        margin-bottom: 10px;
    }

    .db-hero-actions {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

        .db-hero-actions a {
            background: rgba(255, 255, 255, .16);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, .25);
            border-radius: 12px;
            padding: 9px 16px;
            font-size: .88rem;
            font-weight: 500;
            text-decoration: none;
            transition: background .2s ease;
        }

            .db-hero-actions a:hover {
                background: rgba(255, 255, 255, .28);
            }

    .db-kpi {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 20px;
        height: 100%;
    }

    .db-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .db-kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        font-size: 19px;
    }

    .db-kpi-sub {
        font-size: .76rem;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--primary-soft);
        color: var(--primary);
    }

    .db-kpi-value {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

    .db-kpi-label {
        font-size: .85rem;
        color: var(--muted);
        margin-top: 4px;
    }

    .c-indigo {
        background: rgba(79, 70, 229, .12);
        color: #4f46e5;
    }

    .c-sky {
        background: rgba(14, 165, 233, .12);
        color: #0284c7;
    }

    .c-emerald {
        background: rgba(16, 185, 129, .12);
        color: #059669;
    }

    .c-amber {
        background: rgba(245, 158, 11, .12);
        color: #d97706;
    }

    .c-rose {
        background: rgba(244, 63, 94, .12);
        color: #e11d48;
    }

    .db-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px;
        height: 100%;
    }

    .db-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .db-panel-title {
        font-weight: 700;
        color: var(--text);
        margin: 0;
        font-size: 1rem;
    }

    .db-panel-link {
        font-size: .82rem;
        font-weight: 600;
        color: var(--primary);
        text-decoration: none;
    }

    .db-chart {
        position: relative;
        height: 280px;
    }

        .db-chart.sm {
            height: 230px;
        }

    .db-bar-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .db-bar-row + .db-bar-row {
            margin-top: 14px;
        }

    .db-bar-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: .78rem;
        flex-shrink: 0;
        background: var(--primary-soft);
        color: var(--primary);
    }

    .db-bar-top {
        display: flex;
        justify-content: space-between;
        font-size: .85rem;
        margin-bottom: 5px;
    }

        .db-bar-top span:first-child {
            color: var(--text);
            font-weight: 500;
        }

        .db-bar-top span:last-child {
            color: var(--muted);
            font-weight: 600;
        }

    .db-bar-track {
        height: 7px;
        background: var(--primary-soft);
        border-radius: 999px;
        overflow: hidden;
    }

    .db-bar-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--primary), #818cf8);
    }

    .db-listing {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .db-listing + .db-listing {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

        .db-listing img {
            width: 58px;
            height: 44px;
            border-radius: 10px;
            object-fit: cover;
            flex-shrink: 0;
            background: var(--primary-soft);
        }

    .db-listing-title {
        font-weight: 600;
        color: var(--text);
        font-size: .9rem;
        line-height: 1.3;
    }

    .db-listing-meta {
        font-size: .78rem;
        color: var(--muted);
    }

    .db-listing-price {
        margin-left: auto;
        font-weight: 700;
        color: var(--text);
        font-size: .9rem;
        white-space: nowrap;
    }

    .db-msg {
        display: flex;
        gap: 12px;
    }

        .db-msg + .db-msg {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

    .db-msg-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: .8rem;
        flex-shrink: 0;
    }

    .db-msg-top {
        display: flex;
        justify-content: space-between;
        gap: 8px;
    }

    .db-msg-name {
        font-weight: 600;
        color: var(--text);
        font-size: .88rem;
    }

    .db-msg-time {
        font-size: .74rem;
        color: var(--muted);
        white-space: nowrap;
    }

    .db-msg-text {
        font-size: .82rem;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .db-quick {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

        .db-quick a {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 18px 10px;
            border: 1px solid var(--line);
            border-radius: 14px;
            color: var(--text);
            text-decoration: none;
            font-size: .85rem;
            font-weight: 500;
            text-align: center;
            transition: all .2s ease;
        }

            .db-quick a i {
                font-size: 20px;
                color: var(--primary);
            }

            .db-quick a:hover {
                border-color: var(--primary);
                background: var(--primary-soft);
                color: var(--primary);
            }

    .db-price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
    }

        .db-price-row + .db-price-row {
            border-top: 1px solid var(--line);
        }

        .db-price-row span:first-child {
            color: var(--text);
            font-weight: 500;
            font-size: .88rem;
        }

        .db-price-row small {
            color: var(--muted);
            font-size: .76rem;
            margin-left: 6px;
        }

        .db-price-row span:last-child {
            color: var(--text);
            font-weight: 700;
            font-size: .88rem;
        }
</style>

<div class="container-fluid pt-4 px-4">

    <!-- Karşılama -->
    <div class="db-hero mb-4">
        <div class="position-relative" style="z-index: 1;">
            <div class="db-hero-date"><i class="fa fa-calendar-alt me-1"></i>@today</div>
            <h3>@greeting, Emre 👋</h3>
            <p>Bugün 3 yeni mesajın ve 2 yeni bülten abonen var. İşte sitenin genel durumu.</p>
        </div>
        <div class="db-hero-actions">
            <a asp-area="Admin" asp-controller="Product" asp-action="CreateProduct"><i class="fa fa-plus me-2"></i>Yeni İlan</a>
            <a asp-area="Admin" asp-controller="Contact" asp-action="Index"><i class="fa fa-inbox me-2"></i>Mesajlar</a>
            <a asp-area="" asp-controller="Default" asp-action="Index" target="_blank"><i class="fa fa-external-link-alt me-2"></i>Siteyi Görüntüle</a>
        </div>
    </div>

    @await Component.InvokeAsync("DashboardSummaryCard")

    <!-- Şehir grafiği + hızlı işlemler -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="db-panel">
                <div class="db-panel-head">
                    <h6 class="db-panel-title">Şehirlere Göre İlan Dağılımı</h6>
                    <a asp-area="Admin" asp-controller="Statistic" asp-action="Index" class="db-panel-link">Detaylı istatistik</a>
                </div>
                <div class="db-chart"><canvas id="cityChart"></canvas></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="db-panel">
                <div class="db-panel-head">
                    <h6 class="db-panel-title">Hızlı İşlemler</h6>
                </div>
                <div class="db-quick">
                    <a asp-area="Admin" asp-controller="Product" asp-action="CreateProduct"><i class="fa fa-home"></i>İlan Ekle</a>
                    <a asp-area="Admin" asp-controller="Employee" asp-action="CreateEmployee"><i class="fa fa-user-tie"></i>Danışman Ekle</a>
                    <a asp-area="Admin" asp-controller="Category" asp-action="CreateCategory"><i class="fa fa-layer-group"></i>Kategori Ekle</a>
                    <a asp-area="Admin" asp-controller="Testimonial" asp-action="CreateTestimonial"><i class="fa fa-quote-left"></i>Yorum Ekle</a>
                    <a asp-area="Admin" asp-controller="Statistic" asp-action="Index"><i class="fa fa-chart-bar"></i>İstatistikler</a>
                    <a asp-area="Admin" asp-controller="Adress" asp-action="Index"><i class="fa fa-map-marker-alt"></i>İletişim Bilgileri</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Kategori + danışman + son 7 gün mesaj -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6 col-xl-4">
            <div class="db-panel">
                <div class="db-panel-head">
                    <h6 class="db-panel-title">Kategori Dağılımı</h6>
                </div>
                <div class="db-chart sm"><canvas id="categoryChart"></canvas></div>
            </div>
        </div>

        @await Component.InvokeAsync("DashboardEmployeePerformance")

        <div class="col-lg-12 col-xl-4">
            <div class="db-panel">
                <div class="db-panel-head">
                    <h6 class="db-panel-title">Son 7 Günde Gelen Mesajlar</h6>
                </div>
                <div class="db-chart sm"><canvas id="messageChart"></canvas></div>
            </div>
        </div>
    </div>

    <!-- Son ilanlar + son mesajlar + kategori ortalama fiyat -->
    <div class="row g-4 mb-4">
        @await Component.InvokeAsync("DashboardLastProducts")

        @await Component.InvokeAsync("DashboardLastMessages")    

        @await Component.InvokeAsync("DashboardAveragePriceByCategory")
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof Chart === "undefined") return;

        new Chart(document.getElementById("cityChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(ViewBag.City),
                datasets: [{
                    label: "İlan sayısı",
                    data: @Html.Raw(ViewBag.ProductCountByCity),
                    backgroundColor: "rgba(79, 70, 229, .75)",
                    hoverBackgroundColor: "#4f46e5",
                    borderRadius: 8,
                    maxBarThickness: 42
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById("categoryChart"), {
            type: "doughnut",
            data: {
                labels: @Html.Raw(ViewBag.CategoryName),
                datasets: [{
                    data: @Html.Raw(ViewBag.ProductCount),
                    backgroundColor: ["#4f46e5", "#0ea5e9", "#10b981", "#f59e0b", "#f43f5e", "#8b5cf6", "#64748b"],
                    borderWidth: 2,
                    borderColor: "#fff"
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: "65%" }
        });

        new Chart(document.getElementById("messageChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(ViewBag.Date),
                datasets: [{
                    label: "Mesaj",
                    data:  @Html.Raw(ViewBag.MessageCount),
                    backgroundColor: "rgba(244, 63, 94, .7)",
                    hoverBackgroundColor: "#f43f5e",
                    borderRadius: 6,
                    maxBarThickness: 26
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
    });
</script>