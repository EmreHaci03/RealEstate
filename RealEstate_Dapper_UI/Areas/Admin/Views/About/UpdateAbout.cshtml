@model UpdateAboutDto
@{
    ViewData["Title"] = "Hakkımızda Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="mb-0"><i class="fa fa-pen text-primary me-2"></i>Hakkımızda Güncelle</h5>
            <a asp-area="Admin" asp-controller="About" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>Geri
            </a>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle me-2"></i>@ViewBag.ErrorMessage</div>
        }

        <form asp-area="Admin" asp-controller="About" asp-action="UpdateAbout" method="post">
            <input type="hidden" asp-for="AboutId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlık</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="PhoneNumber" class="form-label">Telefon</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-phone-alt"></i></span>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-warning">
                <i class="fa fa-save me-1"></i>Güncelle
            </button>
        </form>
    </div>
</div>
