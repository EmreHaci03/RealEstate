@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Canlı İstatistikler";
}

<style>
    .live-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
        background: rgba(107, 114, 128, .12);
        color: #6b7280;
    }

        .live-status .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: currentColor;
        }

        .live-status.connected {
            background: rgba(16, 185, 129, .12);
            color: #059669;
        }

            .live-status.connected .dot {
                animation: pulse 1.6s infinite;
            }

        .live-status.error {
            background: rgba(244, 63, 94, .12);
            color: #e11d48;
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, .6);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }

    .live-updated {
        font-size: .82rem;
        color: var(--muted);
    }

    .live-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 20px;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: border-color .3s ease, box-shadow .3s ease;
    }

        .live-card.flash {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-soft);
        }

    .live-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .live-value {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

        .live-value.text {
            font-size: 1.15rem;
        }

    .live-label {
        font-size: .84rem;
        color: var(--muted);
        margin-top: 4px;
    }

    .c-indigo {
        background: rgba(79, 70, 229, .12);
        color: #4f46e5;
    }

    .c-sky {
        background: rgba(14, 165, 233, .12);
        color: #0284c7;
    }

    .c-emerald {
        background: rgba(16, 185, 129, .12);
        color: #059669;
    }

    .c-amber {
        background: rgba(245, 158, 11, .12);
        color: #d97706;
    }

    .c-rose {
        background: rgba(244, 63, 94, .12);
        color: #e11d48;
    }

    .c-violet {
        background: rgba(139, 92, 246, .12);
        color: #7c3aed;
    }

    .live-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px;
        height: 100%;
    }

    .live-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .live-panel-title {
        font-weight: 700;
        color: var(--text);
        margin: 0;
        font-size: 1rem;
    }

    .feed {
        max-height: 380px;
        overflow-y: auto;
    }

    .feed-item {
        display: flex;
        gap: 12px;
        padding: 12px 0;
        animation: slideIn .4s ease;
    }

        .feed-item + .feed-item {
            border-top: 1px solid var(--line);
        }

    .feed-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(244, 63, 94, .12);
        color: #e11d48;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .feed-title {
        font-weight: 600;
        color: var(--text);
        font-size: .88rem;
    }

    .feed-text {
        font-size: .82rem;
        color: var(--muted);
    }

    .feed-time {
        font-size: .74rem;
        color: var(--muted);
        margin-left: auto;
        white-space: nowrap;
    }

    .feed-empty {
        text-align: center;
        padding: 40px 10px;
        color: var(--muted);
        font-size: .88rem;
    }

        .feed-empty i {
            display: block;
            font-size: 26px;
            color: var(--primary);
            margin-bottom: 8px;
        }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .interval-group {
        display: inline-flex;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 3px;
    }

    .interval-btn {
        border: 0;
        background: transparent;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 500;
        color: var(--muted);
    }

        .interval-btn.active {
            background: var(--primary);
            color: #fff;
        }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Canlı İstatistikler</h4>
            <p class="mb-0" style="color: var(--muted);">Veriler SignalR ile sayfayı yenilemeden anlık güncellenir.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="live-updated">Son güncelleme: <b id="lastUpdated">-</b></span>
            <span class="live-status" id="connectionStatus"><span class="dot"></span><span id="statusText">Bağlanıyor...</span></span>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <div class="interval-group" role="group" aria-label="Yenileme aralığı">
            <button type="button" class="interval-btn" data-interval="3000">3 sn</button>
            <button type="button" class="interval-btn active" data-interval="5000">5 sn</button>
            <button type="button" class="interval-btn" data-interval="10000">10 sn</button>
        </div>
    </div>

    <!-- Canlı kartlar -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="totalProduct">
                <div class="live-icon c-indigo"><i class="fa fa-home"></i></div>
                <div><div class="live-value">-</div><div class="live-label">Toplam İlan</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="totalCategory">
                <div class="live-icon c-sky"><i class="fa fa-layer-group"></i></div>
                <div><div class="live-value">-</div><div class="live-label">Kategori</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="activeEmployee">
                <div class="live-icon c-amber"><i class="fa fa-user-tie"></i></div>
                <div><div class="live-value">-</div><div class="live-label">Aktif Danışman</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="activeSubscriber">
                <div class="live-icon c-violet"><i class="fa fa-paper-plane"></i></div>
                <div><div class="live-value">-</div><div class="live-label">Aktif Abone</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="totalCity">
                <div class="live-icon c-emerald"><i class="fa fa-city"></i></div>
                <div><div class="live-value">-</div><div class="live-label">Farklı Şehir</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="averagePrice" data-format="price">
                <div class="live-icon c-emerald"><i class="fa fa-lira-sign"></i></div>
                <div><div class="live-value">-</div><div class="live-label">Ortalama Fiyat</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="topCity" data-format="text">
                <div class="live-icon c-rose"><i class="fa fa-map-marker-alt"></i></div>
                <div><div class="live-value text">-</div><div class="live-label">En Çok İlan Olan Şehir</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="live-card" data-key="topEmployee" data-format="text">
                <div class="live-icon c-amber"><i class="fa fa-trophy"></i></div>
                <div><div class="live-value text">-</div><div class="live-label">En Çok İlanı Olan Danışman</div></div>
            </div>
        </div>
    </div>

    <!-- Canlı mesaj akışı -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="live-panel">
                <div class="live-panel-head">
                    <h6 class="live-panel-title"><i class="fa fa-bolt me-2" style="color: #f59e0b;"></i>Canlı Mesaj Akışı</h6>
                    <span class="badge rounded-pill px-3 py-2" style="background: var(--primary-soft); color: var(--primary);">
                        Bu oturumda <b id="newMessageCount">0</b> yeni mesaj
                    </span>
                </div>
                <div class="feed" id="messageFeed">
                    <div class="feed-empty" id="feedEmpty">
                        <i class="fa fa-satellite-dish"></i>
                        Yeni mesaj bekleniyor. İletişim formundan bir mesaj gönderildiğinde burada anında görünecek.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", async function () {
        var formatter = new Intl.NumberFormat("tr-TR");
        var statusEl = document.getElementById("connectionStatus");
        var statusText = document.getElementById("statusText");
        var refreshTimer = null;
        var refreshInterval = 5000;
        var newMessageCount = 0;

        function setStatus(state, text) {
            statusEl.className = "live-status " + state;
            statusText.textContent = text;
        }

        function formatValue(value, format) {
            if (value === null || value === undefined || value === "") return "-";
            if (format === "price") return "₺" + formatter.format(Math.round(value));
            if (format === "text") return value;
            return formatter.format(value);
        }

        function escapeHtml(text) {
            var div = document.createElement("div");
            div.textContent = text ?? "";
            return div.innerHTML;
        }

        var connection = new signalR.HubConnectionBuilder()
            .withUrl("https://localhost:7025/signalrhub")
            .withAutomaticReconnect()
            .build();

        // İstatistikler geldiğinde kartları güncelle
        connection.on("ReceiveStatistics", function (data) {
            document.querySelectorAll(".live-card").forEach(function (card) {
                var key = card.getAttribute("data-key");
                var format = card.getAttribute("data-format");
                var valueEl = card.querySelector(".live-value");
                var newText = formatValue(data[key], format);

                if (valueEl.textContent !== newText) {
                    var isFirstLoad = valueEl.textContent === "-";
                    valueEl.textContent = newText;
                    if (!isFirstLoad) {
                        card.classList.add("flash");
                        setTimeout(function () { card.classList.remove("flash"); }, 1200);
                    }
                }
            });

            document.getElementById("lastUpdated").textContent =
                new Date().toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
        });

        // Yeni mesaj geldiğinde akışa ekle
        connection.on("ReceiveNewMessage", function (name, subject) {
            var empty = document.getElementById("feedEmpty");
            if (empty) empty.remove();

            var time = new Date().toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
            var item = document.createElement("div");
            item.className = "feed-item";
            item.innerHTML =
                '<div class="feed-icon"><i class="fa fa-envelope"></i></div>' +
                '<div><div class="feed-title">' + escapeHtml(name) + '</div>' +
                '<div class="feed-text">' + escapeHtml(subject) + '</div></div>' +
                '<div class="feed-time">' + time + '</div>';

            document.getElementById("messageFeed").prepend(item);

            newMessageCount++;
            document.getElementById("newMessageCount").textContent = newMessageCount;

            // Mesaj sayısı değiştiği için istatistikleri hemen yenile
            connection.invoke("SendStatistics").catch(function () { });
        });

        function startRefresh() {
            clearInterval(refreshTimer);
            refreshTimer = setInterval(function () {
                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SendStatistics").catch(function (err) { console.error(err); });
                }
            }, refreshInterval);
        }

        // Yenileme aralığı seçimi
        document.querySelectorAll(".interval-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".interval-btn").forEach(function (b) { b.classList.remove("active"); });
                this.classList.add("active");
                refreshInterval = parseInt(this.getAttribute("data-interval"));
                startRefresh();
            });
        });

        connection.onreconnecting(function () { setStatus("", "Yeniden bağlanıyor..."); });
        connection.onreconnected(function () {
            setStatus("connected", "Canlı");
            connection.invoke("SendStatistics");
        });
        connection.onclose(function () { setStatus("error", "Bağlantı koptu"); });

        try {
            await connection.start();
            setStatus("connected", "Canlı");
            await connection.invoke("SendStatistics");
            startRefresh();
        } catch (err) {
            console.error("SignalR bağlantı hatası:", err);
            setStatus("error", "Bağlanamadı");
        }
    });
</script>