@model CreateAmenityPropertyDto
@{
    ViewData["Title"] = "İlana Olanak Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
            <div>
                <h5 class="mb-1"><i class="fa fa-plus-circle text-primary me-2"></i>İlana Olanak Ekle</h5>
                <small class="text-muted">Bir ilana olanak atayın ve durumunu belirleyin</small>
            </div>
            <a asp-area="Admin" asp-controller="AmenityProperty" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>İlan Olanakları
            </a>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-circle me-2"></i>@ViewBag.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="bg-white rounded p-4" style="border: 1px solid #eef0f4;">
            <form asp-area="Admin" asp-controller="AmenityProperty" asp-action="CreateAmenityProperty" method="post">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Product" class="form-label fw-semibold">İlan</label>
                        <select asp-for="Product" asp-items="ViewBag.Products" class="form-select" required>
                            <option value="">-- İlan seçin --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Amenity" class="form-label fw-semibold">Olanak</label>
                        <select asp-for="Amenity" asp-items="ViewBag.Amenities" class="form-select" required>
                            <option value="">-- Olanak seçin --</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold d-block">Durum</label>
                        <div class="form-check form-switch">
                            <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" checked />
                            <label asp-for="Status" class="form-check-label">Bu ilanda bu olanak var</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 pt-4 mt-4 border-top">
                    <button type="submit" class="btn btn-primary px-4"><i class="fa fa-save me-2"></i>Kaydet</button>
                    <a asp-area="Admin" asp-controller="AmenityProperty" asp-action="Index" class="btn btn-light px-4">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>
