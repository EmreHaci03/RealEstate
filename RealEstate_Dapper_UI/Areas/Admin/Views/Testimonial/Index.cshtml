@model List<ResultTestimonialDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Müşteri Yorumları";

    var totalCount = Model.Count;
    var activeCount = Model.Count(x => x.Status);
    var passiveCount = totalCount - activeCount;

    string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Any() ? string.Concat(parts.Take(2).Select(p => p[0])).ToUpper() : "?";
    }
}

<style>
    .tst-page .stat-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
    }

    .tst-page .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 18px;
        flex-shrink: 0;
    }

        .tst-page .stat-icon.total {
            background: var(--primary-soft);
            color: var(--primary);
        }

        .tst-page .stat-icon.active {
            background: rgba(16, 185, 129, .12);
            color: #059669;
        }

        .tst-page .stat-icon.passive {
            background: rgba(107, 114, 128, .12);
            color: #6b7280;
        }

    .tst-page .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: var(--text);
    }

    .tst-page .stat-label {
        font-size: .82rem;
        color: var(--muted);
        margin-top: 4px;
    }

    .tst-page .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

    .tst-page .search-box {
        position: relative;
        max-width: 300px;
        width: 100%;
    }

        .tst-page .search-box i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: .85rem;
        }

        .tst-page .search-box input {
            padding-left: 38px;
            height: 42px;
        }

    .tst-page .filter-group {
        display: inline-flex;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 3px;
    }

    .tst-page .filter-btn {
        border: 0;
        background: transparent;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: .85rem;
        font-weight: 500;
        color: var(--muted);
    }

        .tst-page .filter-btn.active {
            background: var(--primary);
            color: #fff;
        }

    .tst-card {
        height: 100%;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px;
        position: relative;
        display: flex;
        flex-direction: column;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .tst-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 36px -20px rgba(16, 24, 40, .3);
            border-color: transparent;
        }

        .tst-card.is-passive {
            opacity: .65;
        }

    .tst-quote {
        position: absolute;
        top: 18px;
        right: 20px;
        font-size: 30px;
        color: var(--primary-soft);
    }

    .tst-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        padding-right: 30px;
    }

    .tst-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), #818cf8);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .tst-name {
        font-weight: 700;
        color: var(--text);
        line-height: 1.3;
    }

    .tst-title {
        font-size: .8rem;
        color: var(--muted);
    }

    .tst-stars {
        color: #f5b301;
        font-size: .78rem;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .tst-comment {
        color: var(--muted);
        font-size: .9rem;
        line-height: 1.65;
        font-style: italic;
        flex: 1;
        margin-bottom: 16px;
    }

    .tst-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid var(--line);
    }

    .tst-page .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: .76rem;
        font-weight: 600;
    }

        .tst-page .status-pill::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .tst-page .status-pill.active {
            background: rgba(16, 185, 129, .12);
            color: #059669;
        }

        .tst-page .status-pill.passive {
            background: rgba(107, 114, 128, .12);
            color: #6b7280;
        }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-grid;
        place-items: center;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--muted);
        transition: all .15s ease;
    }

        .action-btn.edit:hover {
            background: var(--primary-soft);
            color: var(--primary);
            border-color: transparent;
        }

        .action-btn.delete:hover {
            background: rgba(239, 68, 68, .1);
            color: #dc2626;
            border-color: transparent;
        }

    .tst-page .empty-state {
        text-align: center;
        padding: 56px 20px;
    }

    .tst-page .empty-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        background: var(--primary-soft);
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 28px;
        margin: 0 auto 16px;
    }

    .delete-modal .modal-content {
        border: none;
        border-radius: 20px;
        box-shadow: 0 24px 60px rgba(16, 24, 40, .2);
    }

    .delete-modal .modal-body {
        padding: 32px 28px 8px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(239, 68, 68, .1);
        color: #dc2626;
        display: grid;
        place-items: center;
        font-size: 26px;
        margin: 0 auto 18px;
        box-shadow: 0 0 0 10px rgba(239, 68, 68, .05);
    }

    .delete-modal h5 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .delete-modal .delete-text {
        color: var(--muted);
        font-size: .92rem;
        margin-bottom: 0;
    }

    .delete-modal .delete-name {
        color: var(--text);
        font-weight: 600;
    }

    .delete-modal .modal-footer {
        border: none;
        padding: 20px 28px 28px;
        gap: 10px;
    }

        .delete-modal .modal-footer .btn {
            flex: 1;
            height: 44px;
            border-radius: 12px;
            font-weight: 600;
        }

    .delete-modal .btn-danger {
        background: #dc2626;
        border-color: #dc2626;
    }

        .delete-modal .btn-danger:hover {
            background: #b91c1c;
            border-color: #b91c1c;
        }
</style>

<div class="container-fluid pt-4 px-4 tst-page">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Müşteri Yorumları</h4>
            <p class="mb-0" style="color: var(--muted);">Ana sayfadaki "Müşterilerimiz" bölümünde dönen yorumları buradan yönetebilirsiniz.</p>
        </div>
        <a asp-area="Admin" asp-controller="Testimonial" asp-action="CreateTestimonial" class="btn btn-primary px-4">
            <i class="fa fa-plus me-2"></i>Yeni Yorum
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="stat-card">
                <div class="stat-icon total"><i class="fa fa-comments"></i></div>
                <div><div class="stat-value">@totalCount</div><div class="stat-label">Toplam yorum</div></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-card">
                <div class="stat-icon active"><i class="fa fa-eye"></i></div>
                <div><div class="stat-value">@activeCount</div><div class="stat-label">Sitede görünen</div></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-card">
                <div class="stat-icon passive"><i class="fa fa-eye-slash"></i></div>
                <div><div class="stat-value">@passiveCount</div><div class="stat-label">Gizli</div></div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="bg-light rounded p-4">
        @if (Model.Any())
        {
            <div class="toolbar">
                <div class="filter-group" role="group" aria-label="Duruma göre filtrele">
                    <button type="button" class="filter-btn active" data-filter="all">Tümü</button>
                    <button type="button" class="filter-btn" data-filter="active">Aktif</button>
                    <button type="button" class="filter-btn" data-filter="passive">Pasif</button>
                </div>
                <div class="search-box">
                    <i class="fa fa-search"></i>
                    <input type="text" id="testimonialSearch" class="form-control" placeholder="İsim, meslek veya yorum ara..." />
                </div>
            </div>

            <div class="row g-3" id="testimonialGrid">
                @foreach (var item in Model)
                {
                    var searchText = $"{item.NameSurname} {item.Title} {item.Comment}".ToLower();

                    <div class="col-md-6 col-xl-4 tst-item" data-search="@searchText" data-status="@(item.Status ? "active" : "passive")">
                        <div class="tst-card @(item.Status ? "" : "is-passive")">
                            <i class="fa fa-quote-right tst-quote"></i>
                            <div class="tst-head">
                                <div class="tst-avatar">@Initials(item.NameSurname)</div>
                                <div>
                                    <div class="tst-name">@item.NameSurname</div>
                                    <div class="tst-title">@item.Title</div>
                                </div>
                            </div>
                            <div class="tst-stars">
                                <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                            </div>
                            <p class="tst-comment">"@item.Comment"</p>
                            <div class="tst-foot">
                                @if (item.Status)
                                {
                                    <span class="status-pill active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill passive">Pasif</span>
                                }
                                <div class="d-flex gap-1">
                                    <a asp-area="Admin" asp-controller="Testimonial" asp-action="UpdateTestimonial" asp-route-id="@item.TestimonialId"
                                       class="action-btn edit" title="Düzenle">
                                        <i class="fa fa-pen"></i>
                                    </a>
                                    <button type="button" class="action-btn delete" title="Sil"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-name="@item.NameSurname"
                                            data-url="@Url.Action("DeleteTestimonial", "Testimonial", new { area = "Admin", id = item.TestimonialId })">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="noResult" class="text-center py-4" style="display: none; color: var(--muted);">
                <i class="fa fa-search me-2"></i>Eşleşen yorum bulunamadı.
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa fa-comments"></i></div>
                <h5 class="fw-bold mb-1">Henüz yorum yok</h5>
                <p class="mb-4" style="color: var(--muted);">Ana sayfada gösterilecek ilk müşteri yorumunu ekleyin.</p>
                <a asp-area="Admin" asp-controller="Testimonial" asp-action="CreateTestimonial" class="btn btn-primary px-4">
                    <i class="fa fa-plus me-2"></i>Yorum Ekle
                </a>
            </div>
        }
    </div>
</div>

<!-- Silme modalı -->
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon"><i class="fa fa-trash-alt"></i></div>
                <h5 id="deleteModalLabel">Yorumu sil</h5>
                <p class="delete-text">
                    <span class="delete-name" id="deleteTestimonialName"></span> adlı müşterinin yorumunu silmek üzeresiniz.
                    Bu işlem geri alınamaz. Sadece gizlemek istiyorsanız yorumu pasif yapabilirsiniz.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Vazgeç</button>
                <form id="deleteForm" method="post" class="d-flex flex-fill m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa fa-trash-alt me-2"></i>Evet, sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("deleteModal").addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            document.getElementById("deleteTestimonialName").textContent = "\"" + button.getAttribute("data-name") + "\"";
            document.getElementById("deleteForm").setAttribute("action", button.getAttribute("data-url"));
        });

        var searchInput = document.getElementById("testimonialSearch");
        var filterButtons = document.querySelectorAll(".filter-btn");
        var currentFilter = "all";

        function applyFilters() {
            var term = searchInput ? searchInput.value.trim().toLocaleLowerCase("tr") : "";
            var items = document.querySelectorAll("#testimonialGrid .tst-item");
            var visibleCount = 0;

            items.forEach(function (item) {
                var matchSearch = item.getAttribute("data-search").toLocaleLowerCase("tr").includes(term);
                var matchFilter = currentFilter === "all" || item.getAttribute("data-status") === currentFilter;
                var visible = matchSearch && matchFilter;
                item.style.display = visible ? "" : "none";
                if (visible) visibleCount++;
            });

            var noResult = document.getElementById("noResult");
            if (noResult) noResult.style.display = visibleCount === 0 ? "" : "none";
        }

        if (searchInput) searchInput.addEventListener("input", applyFilters);

        filterButtons.forEach(function (btn) {
            btn.addEventListener("click", function () {
                filterButtons.forEach(function (b) { b.classList.remove("active"); });
                this.classList.add("active");
                currentFilter = this.getAttribute("data-filter");
                applyFilters();
            });
        });
    });
</script>