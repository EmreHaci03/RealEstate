@model GetContactByIdDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Mesaj Detayı";

    var parts = (Model.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Any() ? string.Concat(parts.Take(2).Select(p => p[0])).ToUpper() : "?";
}

<style>
    .msg-detail {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
    }

    .msg-detail-head {
        padding: 24px 28px;
        border-bottom: 1px solid var(--line);
    }

    .msg-detail-subject {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 18px;
        line-height: 1.35;
    }

    .msg-sender {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .msg-sender-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--primary-soft);
        color: var(--primary);
        display: grid;
        place-items: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .msg-sender-name {
        font-weight: 600;
        color: var(--text);
    }

    .msg-sender-mail {
        font-size: .85rem;
        color: var(--muted);
    }

    .msg-sender-date {
        margin-left: auto;
        text-align: right;
        font-size: .82rem;
        color: var(--muted);
        white-space: nowrap;
    }

    .msg-detail-body {
        padding: 28px;
        font-size: .95rem;
        line-height: 1.8;
        color: var(--text);
        white-space: pre-line;
        word-break: break-word;
    }

    .msg-detail-foot {
        padding: 18px 28px;
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        background: var(--page-bg);
    }

    .info-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px;
    }

        .info-card h6 {
            font-size: .75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--muted);
            margin-bottom: 16px;
        }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: .88rem;
    }

        .info-row + .info-row {
            margin-top: 14px;
        }

        .info-row i {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: var(--primary-soft);
            color: var(--primary);
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }

        .info-row small {
            display: block;
            color: var(--muted);
            font-size: .75rem;
        }

        .info-row span {
            color: var(--text);
            font-weight: 500;
            word-break: break-all;
        }

    /* Cevap paneli */
    .reply-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        margin-top: 24px;
        scroll-margin-top: 90px;
    }

    .reply-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 18px 24px;
        border-bottom: 1px solid var(--line);
    }

        .reply-head h6 {
            margin: 0;
            font-weight: 700;
            color: var(--text);
        }

        .reply-head small {
            color: var(--muted);
        }

    .reply-to {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 14px 24px 0;
        font-size: .84rem;
        color: var(--muted);
    }

        .reply-to b {
            color: var(--text);
            font-weight: 600;
        }

    .reply-body {
        padding: 14px 24px 18px;
    }

        .reply-body textarea {
            min-height: 220px;
            border-radius: 12px;
            line-height: 1.7;
            resize: vertical;
        }

    .reply-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        padding: 16px 24px;
        border-top: 1px solid var(--line);
        background: var(--page-bg);
    }

    .reply-count {
        margin-left: auto;
        font-size: .78rem;
        color: var(--muted);
    }

    .ai-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 0;
        border-radius: 999px;
        padding: 8px 16px;
        font-size: .85rem;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #6f42c1, #009CFF);
        box-shadow: 0 6px 16px -8px rgba(111, 66, 193, .7);
        transition: filter .2s, transform .2s;
    }

        .ai-btn:hover {
            filter: brightness(1.08);
            transform: translateY(-1px);
        }

        .ai-btn:disabled {
            opacity: .7;
            transform: none;
            cursor: wait;
        }

    .reply-error {
        display: none;
        font-size: .82rem;
        color: #dc3545;
        margin-top: 8px;
        word-break: break-word;
    }

    .reply-toast {
        display: none;
        font-size: .82rem;
        color: #198754;
        font-weight: 600;
    }

    .delete-modal .modal-content {
        border: none;
        border-radius: 20px;
        box-shadow: 0 24px 60px rgba(16, 24, 40, .2);
    }

    .delete-modal .modal-body {
        padding: 32px 28px 8px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(239, 68, 68, .1);
        color: #dc2626;
        display: grid;
        place-items: center;
        font-size: 26px;
        margin: 0 auto 18px;
        box-shadow: 0 0 0 10px rgba(239, 68, 68, .05);
    }

    .delete-modal h5 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .delete-modal .delete-text {
        color: var(--muted);
        font-size: .92rem;
        margin-bottom: 0;
    }

    .delete-modal .modal-footer {
        border: none;
        padding: 20px 28px 28px;
        gap: 10px;
    }

        .delete-modal .modal-footer .btn {
            flex: 1;
            height: 44px;
            border-radius: 12px;
            font-weight: 600;
        }

    .delete-modal .btn-danger {
        background: #dc2626;
        border-color: #dc2626;
    }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Mesaj Detayı</h4>
            <p class="mb-0" style="color: var(--muted);">#@Model.ContactId numaralı mesaj</p>
        </div>
        <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Gelen Kutusuna Dön
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="msg-detail">
                <div class="msg-detail-head">
                    <div class="msg-detail-subject">@Model.Subject</div>
                    <div class="msg-sender">
                        <div class="msg-sender-avatar">@initials</div>
                        <div>
                            <div class="msg-sender-name">@Model.Name</div>
                            <div class="msg-sender-mail">@Model.Mail</div>
                        </div>
                        <div class="msg-sender-date">
                            @Model.SendDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))<br />
                            @Model.SendDate.ToString("HH:mm")
                        </div>
                    </div>
                </div>

                <div class="msg-detail-body">@Model.Message</div>

                <div class="msg-detail-foot">
                    <a href="#replyCard" class="btn btn-primary px-4" id="goReply">
                        <i class="fa fa-reply me-2"></i>Yanıtla
                    </a>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="fa fa-trash me-2"></i>Sil
                    </button>
                </div>
            </div>

            <!-- Cevap paneli -->
            <div class="reply-card" id="replyCard">
                <div class="reply-head">
                    <div>
                        <h6><i class="fa fa-pen me-2 text-primary"></i>Cevap Yaz</h6>
                        <small>Kendin yaz ya da yapay zekâdan taslak al, düzenleyip gönder.</small>
                    </div>
                    <button type="button" id="aiReplyBtn" class="ai-btn"
                            data-url="@Url.Action("GenerateReply", "Contact", new { area = "Admin" })"
                            data-name="@Model.Name"
                            data-subject="@Model.Subject"
                            data-message="@Model.Message">
                        <i class="fa fa-magic"></i><span>AI ile Cevap Üret</span>
                    </button>
                </div>

                <div class="reply-to">
                    <span>Kime: <b>@Model.Name &lt;@Model.Mail&gt;</b></span>
                    <span>·</span>
                    <span>Konu: <b>Re: @Model.Subject</b></span>
                </div>

                <div class="reply-body">
                    <textarea id="replyText" class="form-control" placeholder="Sayın @Model.Name,&#10;&#10;Mesajınız için teşekkür ederiz..."></textarea>
                    <div class="reply-error" id="replyError"></div>
                </div>

                <div class="reply-foot">
                    <button type="button" id="sendReply" class="btn btn-primary px-4">
                        <i class="fa fa-paper-plane me-2"></i>Cevabı Gönder
                    </button>
                    <button type="button" id="copyReply" class="btn btn-light border">
                        <i class="fa fa-copy me-2"></i>Kopyala
                    </button>
                    <span class="reply-toast" id="replyToast"><i class="fa fa-check me-1"></i>Kopyalandı</span>
                    <span class="reply-count"><span id="replyCount">0</span> karakter</span>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="info-card">
                <h6>Gönderen Bilgileri</h6>
                <div class="info-row">
                    <i class="fa fa-user"></i>
                    <div><small>Ad Soyad</small><span>@Model.Name</span></div>
                </div>
                <div class="info-row">
                    <i class="fa fa-envelope"></i>
                    <div><small>E-posta</small><span><a href="mailto:@Model.Mail">@Model.Mail</a></span></div>
                </div>
                <div class="info-row">
                    <i class="fa fa-clock"></i>
                    <div><small>Gönderim Tarihi</small><span>@Model.SendDate.ToString("dd.MM.yyyy HH:mm")</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Silme modalı -->
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon"><i class="fa fa-trash-alt"></i></div>
                <h5 id="deleteModalLabel">Mesajı sil</h5>
                <p class="delete-text">Bu mesajı silmek üzeresiniz. Bu işlem geri alınamaz.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Vazgeç</button>
                <form asp-area="Admin" asp-controller="Contact" asp-action="DeleteContact" asp-route-id="@Model.ContactId"
                      method="post" class="d-flex flex-fill m-0">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa fa-trash-alt me-2"></i>Evet, sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var box = document.getElementById('replyText');
        var err = document.getElementById('replyError');
        var count = document.getElementById('replyCount');
        var mail = '@Model.Mail';
        var subject = 'Re: ' + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Subject ?? ""));

        function updateCount() { count.textContent = box.value.length; }
        box.addEventListener('input', updateCount);

        // Yanıtla → panele kaydır
        document.getElementById('goReply').addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('replyCard').scrollIntoView({ behavior: 'smooth' });
            setTimeout(function () { box.focus(); }, 400);
        });

        // AI ile cevap üret
        document.getElementById('aiReplyBtn').addEventListener('click', async function () {
            var btn = this;
            err.style.display = 'none';

            if (box.value.trim() && !confirm('Mevcut metin silinip yerine AI önerisi yazılacak. Devam edilsin mi?')) return;

            var data = new URLSearchParams({
                name: btn.dataset.name,
                subject: btn.dataset.subject,
                message: btn.dataset.message
            });

            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i><span>Yazılıyor...</span>';

            try {
                var res = await fetch(btn.dataset.url, { method: 'POST', body: data });
                var text = await res.text();

                if (res.ok && !res.redirected && !text.trim().startsWith('<')) {
                    box.value = text.trim();
                    updateCount();
                    box.focus();
                } else {
                    err.textContent = text.trim().startsWith('<') ? 'Cevap oluşturulamadı. (Hata ' + res.status + ')' : text;
                    err.style.display = 'block';
                }
            } catch (e) {
                err.textContent = 'Bağlantı hatası, tekrar dene.';
                err.style.display = 'block';
            }

            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-magic"></i><span>AI ile Cevap Üret</span>';
        });

        // Cevabı gönder → mail programı dolu açılır
        document.getElementById('sendReply').addEventListener('click', function () {
            if (!box.value.trim()) {
                err.textContent = 'Önce bir cevap yaz ya da AI ile oluştur.';
                err.style.display = 'block';
                box.focus();
                return;
            }
            window.location.href = 'mailto:' + mail +
                '?subject=' + encodeURIComponent(subject) +
                '&body=' + encodeURIComponent(box.value);
        });

        // Kopyala
        document.getElementById('copyReply').addEventListener('click', async function () {
            if (!box.value.trim()) return;
            await navigator.clipboard.writeText(box.value);
            var toast = document.getElementById('replyToast');
            toast.style.display = 'inline';
            setTimeout(function () { toast.style.display = 'none'; }, 1800);
        });
    })();
</script>