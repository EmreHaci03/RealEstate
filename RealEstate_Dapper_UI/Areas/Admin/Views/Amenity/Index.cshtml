@model List<ResultAmenityDto>
@{
    ViewData["Title"] = "Olanaklar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
            <div>
                <h5 class="mb-1"><i class="fa fa-concierge-bell text-primary me-2"></i>Olanaklar</h5>
                <small class="text-muted">@Model.Count olanak</small>
            </div>
            <div class="d-flex gap-2">
                <input type="text" id="amSearch" class="form-control" placeholder="Ara..." style="max-width: 200px;" />
                <a asp-area="Admin" asp-controller="Amenity" asp-action="CreateAmenity" class="btn btn-primary text-nowrap">
                    <i class="fa fa-plus me-1"></i>Yeni Olanak
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 bg-white rounded">
                <thead>
                    <tr>
                        <th style="width: 80px;">#</th>
                        <th>Olanak</th>
                        <th class="text-end" style="width: 160px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="amBody">
                    @if (!Model.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-4">Henüz olanak eklenmemiş.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr data-title="@item.Title?.ToLower()">
                            <td class="text-muted">@item.AmenityId</td>
                            <td><i class="fa fa-check-circle text-success me-2"></i>@item.Title</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="AmenityProperty" asp-action="GetAmenityPropertyByAmenity" asp-route-id="@item.AmenityId" class="btn btn-sm btn-info text-white" title="İlanları Gör">
                                    <i class="fa fa-list-ul"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Amenity" asp-action="UpdateAmenity" asp-route-id="@item.AmenityId" class="btn btn-sm btn-warning">
                                    <i class="fa fa-pen"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal" data-bs-target="#amDeleteModal"
                                        data-url="@Url.Action("DeleteAmenity", "Amenity", new { area = "Admin", id = item.AmenityId })"
                                        data-title="@item.Title">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Silme Modalı -->
<div class="modal fade" id="amDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0" style="border-radius: 18px;">
            <div class="modal-body text-center p-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger text-white" style="width: 64px; height: 64px; font-size: 24px;">
                    <i class="fa fa-trash-alt"></i>
                </div>
                <h5 class="fw-bold mb-2">Olanağı silmek istiyor musunuz?</h5>
                <p class="text-muted mb-1" id="amDeleteTitle"></p>
                <small class="text-danger"><i class="fa fa-exclamation-triangle me-1"></i>İlanlardaki bu olanak kayıtları da silinir.</small>
            </div>
            <div class="d-flex gap-2 px-4 pb-4">
                <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal">Vazgeç</button>
                <a href="#" id="amDeleteConfirm" class="btn btn-danger flex-fill">Evet, Sil</a>
            </div>
        </div>
    </div>
</div>

<script>document.getElementById('amDeleteModal').addEventListener('show.bs.modal', function (e) {
        var btn = e.relatedTarget;
        document.getElementById('amDeleteTitle').textContent = btn.getAttribute('data-title');
        document.getElementById('amDeleteConfirm').href = btn.getAttribute('data-url');
    });

    document.getElementById('amSearch').addEventListener('input', function () {
        var q = this.value.toLocaleLowerCase('tr-TR').trim();
        document.querySelectorAll('#amBody tr[data-title]').forEach(function (tr) {
            tr.style.display = !q || tr.getAttribute('data-title').indexOf(q) > -1 ? '' : 'none';
        });
    });</script>
