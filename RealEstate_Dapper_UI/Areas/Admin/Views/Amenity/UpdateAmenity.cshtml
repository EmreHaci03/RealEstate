@model UpdateAmenityDto
@{
    ViewData["Title"] = "Olanak Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .am-card {
        background: #fff;
        border: 1px solid #eef0f4;
        border-radius: 14px;
        padding: 24px;
        height: 100%;
    }

    .am-head-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: rgba(0, 156, 255, .1);
        color: #009CFF;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-right: 14px;
    }

    .am-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .am-chip {
        display: inline-flex;
        align-items: center;
        padding: 10px 16px;
        border-radius: 12px;
        background: #f5f7fa;
        font-weight: 600;
        color: #191C24;
    }

        .am-chip i {
            color: #198754;
            margin-right: 8px;
        }

        .am-chip.off {
            color: #9aa1ab;
        }

            .am-chip.off i {
                color: #dc3545;
            }

        .am-chip.new {
            background: rgba(0, 156, 255, .1);
            border: 1px dashed #009CFF;
        }

    .am-tip {
        font-size: 13px;
        color: #6c757d;
    }

        .am-tip li {
            margin-bottom: 6px;
        }
</style>

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
            <div class="d-flex align-items-center">
                <span class="am-head-icon"><i class="fa fa-pen"></i></span>
                <div>
                    <h5 class="mb-1">Olanak Güncelle</h5>
                    <small class="text-muted">Olanağın adını güncelleyin, tüm ilanlarda yeni adıyla görünür</small>
                </div>
            </div>
            <a asp-area="Admin" asp-controller="Amenity" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>Olanaklara Dön
            </a>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-circle me-2"></i>@ViewBag.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="am-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="mb-0"><i class="fa fa-edit text-primary me-2"></i>Olanak Bilgisi</h6>
                        <span class="badge bg-light text-dark border">#@Model.AmenityId</span>
                    </div>

                    <form asp-area="Admin" asp-controller="Amenity" asp-action="UpdateAmenity" method="post">
                        <input type="hidden" asp-for="AmenityId" />
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold">Olanak Adı</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white"><i class="fa fa-check-circle text-success"></i></span>
                                <input asp-for="Title" id="amTitle" class="form-control" placeholder="Örn: Otopark" maxlength="50" required />
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">Kısa ve anlaşılır bir ad yazın</small>
                                <small class="text-muted"><span id="amCount">0</span>/50</small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-warning px-4"><i class="fa fa-save me-2"></i>Güncelle</button>
                            <a asp-area="Admin" asp-controller="Amenity" asp-action="Index" class="btn btn-light px-4">Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="am-card">
                    <h6 class="mb-3"><i class="fa fa-eye text-primary me-2"></i>İlan Detayında Görünümü</h6>
                    <div class="am-preview mb-4">
                        <span class="am-chip"><i class="fa fa-check-circle"></i>Asansör</span>
                        <span class="am-chip new"><i class="fa fa-check-circle"></i><span id="amPreview">Yeni Olanak</span></span>
                        <span class="am-chip off"><i class="fa fa-times-circle"></i>Havuz</span>
                    </div>

                    <h6 class="mb-2"><i class="fa fa-lightbulb text-warning me-2"></i>İpuçları</h6>
                    <ul class="am-tip ps-3 mb-0">
                        <li>Her olanak tüm ilanlarda "var / yok" olarak işaretlenebilir.</li>
                        <li>Aynı olanağı iki kez eklemeyin (ör. "Otopark" ve "Otopark Var").</li>
                        <li>Örnekler: Otopark, Asansör, Havuz, Güvenlik, Doğalgaz, Balkon.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>(function () {
        var input = document.getElementById('amTitle');
        var preview = document.getElementById('amPreview');
        var count = document.getElementById('amCount');
        function sync() {
            preview.textContent = input.value.trim() || 'Yeni Olanak';
            count.textContent = input.value.length;
        }
        input.addEventListener('input', sync);
        sync();
    })();</script>
