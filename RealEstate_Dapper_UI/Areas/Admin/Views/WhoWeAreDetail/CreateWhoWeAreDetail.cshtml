@model CreateWhoWeAreDetailDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Biz Kimiz İçeriği Ekle";
}

<style>
    .wwa-preview-label {
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .wwa-preview {
        position: sticky;
        top: 90px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 30px -18px rgba(16, 24, 40, .25);
    }

    .wwa-preview-badge {
        display: inline-block;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--primary);
        background: var(--primary-soft);
        padding: 5px 12px;
        border-radius: 999px;
    }

    .wwa-preview-subtitle {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text);
        margin: 14px 0;
        line-height: 1.3;
    }

    .wwa-preview-desc {
        color: var(--muted);
        font-size: .9rem;
        line-height: 1.7;
        margin-bottom: 10px;
        white-space: pre-line;
    }

    .char-count {
        font-size: .78rem;
        color: var(--muted);
    }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Biz Kimiz İçeriği Ekle</h4>
            <p class="mb-0" style="color: var(--muted);">Ana sayfada görünecek "Biz Kimiz" bölümünü oluşturun.</p>
        </div>
        <a asp-area="Admin" asp-controller="WhoWeAreDetail" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Geri Dön
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bg-light rounded p-4 h-100">
                <h6 class="mb-4">İçerik Bilgileri</h6>

                <form asp-area="Admin" asp-controller="WhoWeAreDetail" asp-action="CreateWhoWeAreDetail" method="post">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label">Küçük Başlık</label>
                            <input asp-for="Title" class="form-control" data-preview="title" placeholder="Örn: Biz Kimiz" maxlength="100" required />
                            <div class="form-text">Bölümün üstünde etiket olarak görünen kısa başlık.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="SubTitle" class="form-label">Ana Başlık</label>
                            <input asp-for="SubTitle" class="form-control" data-preview="subtitle" placeholder="Örn: Yerel ve uluslararası emlakta güvenilir çözüm ortağınız" maxlength="100" required />
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <label asp-for="Description1" class="form-label">Birinci Paragraf</label>
                                <span class="char-count" id="count1">0</span>
                            </div>
                            <textarea asp-for="Description1" class="form-control" rows="4" data-preview="desc1" required></textarea>
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <label asp-for="Description2" class="form-label">İkinci Paragraf</label>
                                <span class="char-count" id="count2">0</span>
                            </div>
                            <textarea asp-for="Description2" class="form-control" rows="4" data-preview="desc2"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa fa-plus me-2"></i>İçeriği Kaydet
                        </button>
                        <a asp-area="Admin" asp-controller="WhoWeAreDetail" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="wwa-preview-label"><i class="fa fa-eye me-1"></i>Ana Sayfada Böyle Görünecek</div>
            <div class="wwa-preview">
                <span class="wwa-preview-badge" id="pvTitle">Küçük Başlık</span>
                <div class="wwa-preview-subtitle" id="pvSubTitle">Ana başlık burada görünecek</div>
                <p class="wwa-preview-desc" id="pvDesc1">Birinci paragraf burada görünecek.</p>
                <p class="wwa-preview-desc mb-0" id="pvDesc2"></p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var field = function (name) { return document.querySelector('[data-preview="' + name + '"]'); };

        function update() {
            document.getElementById("pvTitle").textContent = field("title").value.trim() || "Küçük Başlık";
            document.getElementById("pvSubTitle").textContent = field("subtitle").value.trim() || "Ana başlık burada görünecek";
            document.getElementById("pvDesc1").textContent = field("desc1").value.trim() || "Birinci paragraf burada görünecek.";
            document.getElementById("pvDesc2").textContent = field("desc2").value.trim();
            document.getElementById("count1").textContent = field("desc1").value.length + " karakter";
            document.getElementById("count2").textContent = field("desc2").value.length + " karakter";
        }

        document.querySelectorAll("[data-preview]").forEach(function (el) {
            el.addEventListener("input", update);
        });

        update();
    });
</script>