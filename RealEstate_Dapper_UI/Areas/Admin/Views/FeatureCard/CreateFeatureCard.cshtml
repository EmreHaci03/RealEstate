@model CreateFeatureCardDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Yeni Özellik Kartı";

    var icons = new[] { "fa fa-search-plus", "fa fa-user-o", "fa fa-line-chart", "fa fa-home", "fa fa-key", "fa fa-handshake-o", "fa fa-calendar", "fa fa-calculator", "fa fa-shield", "fa fa-star", "fa fa-comments", "fa fa-map-marker" };
}

<style>
    .fc-preview-label {
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .fc-preview {
        position: sticky;
        top: 90px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 28px 24px;
        box-shadow: 0 10px 30px -18px rgba(16, 24, 40, .25);
    }

    .fc-preview-icon {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--primary-soft), rgba(129, 140, 248, .15));
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 24px;
        margin-bottom: 18px;
    }

    .fc-preview-subtitle {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 6px;
    }

    .fc-preview-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.4;
        margin-bottom: 8px;
    }

    .fc-preview-desc {
        color: var(--muted);
        font-size: .9rem;
        line-height: 1.65;
        margin-bottom: 16px;
    }

    .fc-preview-button {
        font-size: .88rem;
        font-weight: 600;
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .fc-preview-url {
        font-size: .75rem;
        color: var(--muted);
        margin-top: 6px;
        word-break: break-all;
    }

    .icon-picker {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(46px, 1fr));
        gap: 8px;
        margin-top: 10px;
    }

    .icon-option {
        height: 46px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--muted);
        display: grid;
        place-items: center;
        font-size: 18px;
        cursor: pointer;
        transition: all .15s ease;
    }

        .icon-option:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .icon-option.selected {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

    .section-title {
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--muted);
        margin: 8px 0 4px;
    }

    .char-count {
        font-size: .78rem;
        color: var(--muted);
    }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Yeni Özellik Kartı</h4>
            <p class="mb-0" style="color: var(--muted);">Ana sayfadaki özellik bölümüne butonlu yeni bir kart ekleyin.</p>
        </div>
        <a asp-area="Admin" asp-controller="FeatureCard" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Listeye Dön
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bg-light rounded p-4 h-100">
                <form asp-area="Admin" asp-controller="FeatureCard" asp-action="CreateFeatureCard" method="post">
                    <div class="row g-3">

                        <div class="col-12"><div class="section-title">İçerik</div></div>

                        <div class="col-md-5">
                            <label asp-for="SubTitle" class="form-label">Üst Başlık</label>
                            <input asp-for="SubTitle" class="form-control" data-preview="subtitle" placeholder="Örn: Hepsi tek yerde" maxlength="100" required />
                        </div>

                        <div class="col-md-7">
                            <label asp-for="Title" class="form-label">Başlık</label>
                            <input asp-for="Title" class="form-control" data-preview="title" placeholder="Örn: Hayalinizdeki evi bulmanın en kolay yolu" maxlength="150" required />
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                                <span class="char-count" id="descCount">0 / 250</span>
                            </div>
                            <textarea asp-for="Description" class="form-control" rows="3" data-preview="desc" maxlength="250" placeholder="Kartta görünecek kısa açıklama" required></textarea>
                        </div>

                        <div class="col-12"><div class="section-title">Buton</div></div>

                        <div class="col-md-5">
                            <label asp-for="ButtonText" class="form-label">Buton Yazısı</label>
                            <input asp-for="ButtonText" class="form-control" data-preview="btntext" placeholder="Örn: Ev ara" maxlength="50" required />
                        </div>

                        <div class="col-md-7">
                            <label asp-for="ButtonUrl" class="form-label">Buton Linki</label>
                            <input asp-for="ButtonUrl" class="form-control" data-preview="btnurl" placeholder="Örn: /Property/Index ya da #" maxlength="250" required />
                        </div>

                        <div class="col-12"><div class="section-title">İkon</div></div>

                        <div class="col-12">
                            <input asp-for="Icon" class="form-control" data-preview="icon" placeholder="Örn: fa fa-search-plus" required />
                            <div class="form-text">Aşağıdan seçin ya da Font Awesome sınıfını elle yazın.</div>
                            <div class="icon-picker">
                                @foreach (var icon in icons)
                                {
                                    <button type="button" class="icon-option" data-icon="@icon" title="@icon">
                                        <i class="@icon"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa fa-plus me-2"></i>Kartı Kaydet
                        </button>
                        <a asp-area="Admin" asp-controller="FeatureCard" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="fc-preview-label"><i class="fa fa-eye me-1"></i>Ana Sayfada Böyle Görünecek</div>
            <div class="fc-preview">
                <div class="fc-preview-icon"><i id="pvIcon" class="fa fa-question"></i></div>
                <div class="fc-preview-subtitle" id="pvSubTitle">Üst başlık</div>
                <div class="fc-preview-title" id="pvTitle">Kart başlığı</div>
                <p class="fc-preview-desc" id="pvDesc">Kartın açıklaması burada görünecek.</p>
                <span class="fc-preview-button"><span id="pvBtnText">Buton</span> <i class="fa fa-long-arrow-alt-right"></i></span>
                <div class="fc-preview-url"><i class="fa fa-link me-1"></i><span id="pvBtnUrl">#</span></div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var field = function (name) { return document.querySelector('[data-preview="' + name + '"]'); };
        var options = document.querySelectorAll(".icon-option");

        function update() {
            document.getElementById("pvSubTitle").textContent = field("subtitle").value.trim() || "Üst başlık";
            document.getElementById("pvTitle").textContent = field("title").value.trim() || "Kart başlığı";
            document.getElementById("pvDesc").textContent = field("desc").value.trim() || "Kartın açıklaması burada görünecek.";
            document.getElementById("pvBtnText").textContent = field("btntext").value.trim() || "Buton";
            document.getElementById("pvBtnUrl").textContent = field("btnurl").value.trim() || "#";
            document.getElementById("descCount").textContent = field("desc").value.length + " / 250";

            var icon = field("icon").value.trim();
            document.getElementById("pvIcon").className = icon || "fa fa-question";
            options.forEach(function (btn) {
                btn.classList.toggle("selected", btn.getAttribute("data-icon") === icon);
            });
        }

        options.forEach(function (btn) {
            btn.addEventListener("click", function () {
                field("icon").value = this.getAttribute("data-icon");
                update();
            });
        });

        document.querySelectorAll("[data-preview]").forEach(function (el) {
            el.addEventListener("input", update);
        });

        update();
    });
</script>