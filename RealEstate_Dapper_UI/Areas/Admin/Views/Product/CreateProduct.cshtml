@model CreateProductDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Yeni İlan";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded p-4">

        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h5 class="mb-1 fw-bold">Yeni İlan</h5>
                <p class="mb-0">İlan bilgilerini doldurun.</p>
            </div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>Listeye Dön
            </a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <form asp-area="Admin" asp-controller="Product" asp-action="CreateProduct" method="post">
            <div class="row g-3">

                <div class="col-12">
                    <label asp-for="Title" class="form-label">İlan Başlığı</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Deniz manzaralı 3+1 daire" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label">Kategori</label>
                    <select asp-for="Category" asp-items="ViewBag.Categories" class="form-select" required>
                        <option value="">Kategori seçin</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Employee" class="form-label">Danışman</label>
                    <select asp-for="Employee" asp-items="ViewBag.Employees" class="form-select" required>
                        <option value="">Danışman seçin</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Price" class="form-label">Fiyat (₺)</label>
                    <input asp-for="Price" type="number" min="0" step="1000" class="form-control" placeholder="Örn: 6900000" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="CoverImage" class="form-label">Kapak Resmi (URL)</label>
                    <input asp-for="CoverImage" class="form-control" placeholder="https://..." required />
                </div>

                <div class="col-md-6">
                    <label asp-for="City" class="form-label">Şehir</label>
                    <input asp-for="City" class="form-control" placeholder="Örn: İzmir" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="District" class="form-label">İlçe</label>
                    <input asp-for="District" class="form-control" placeholder="Örn: Urla" required />
                </div>

                <div class="col-12">
                    <label asp-for="Adress" class="form-label">Adres</label>
                    <input asp-for="Adress" class="form-control" placeholder="Mahalle, sokak, kapı no" />
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="İlanın detaylı açıklaması"></textarea>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-plus me-2"></i>İlanı Kaydet
                </button>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>