@model CreateAboutItemDto
@{
    ViewData["Title"] = "Madde Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="mb-0"><i class="fa fa-plus-circle text-primary me-2"></i>Yeni Madde Ekle</h5>
            <a asp-area="Admin" asp-controller="About" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>Geri
            </a>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle me-2"></i>@ViewBag.ErrorMessage</div>
        }

        <form asp-area="Admin" asp-controller="AboutItem" asp-action="CreateAboutItem" method="post">
            <div class="mb-3">
                <label asp-for="About" class="form-label">Hakkımızda Kaydı</label>
                <select asp-for="About" asp-items="ViewBag.Abouts" class="form-select" required>
                    <option value="">-- Seçin --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Icon" class="form-label">İkon</label>
                <input asp-for="Icon" class="form-control" list="iconList" placeholder="fa fa-shield" required />
                <datalist id="iconList">
                    <option value="fa fa-shield"></option>
                    <option value="fa fa-users"></option>
                    <option value="fa fa-line-chart"></option>
                    <option value="fa fa-handshake-o"></option>
                    <option value="fa fa-home"></option>
                    <option value="fa fa-key"></option>
                    <option value="fa fa-star"></option>
                    <option value="fa fa-clock-o"></option>
                </datalist>
                <small class="text-muted">Sitedeki Font Awesome 4 class adı (ör. fa fa-shield)</small>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlık</label>
                <input asp-for="Title" class="form-control" maxlength="50" placeholder="Güvenli Alım Satım" required />
            </div>

            <div class="mb-4">
                <label asp-for="Content" class="form-label">Açıklama</label>
                <textarea asp-for="Content" class="form-control" rows="3" maxlength="70" placeholder="Kısa bir açıklama..." required></textarea>
                <small class="text-muted">En fazla 70 karakter</small>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save me-1"></i>Kaydet
            </button>
        </form>
    </div>
</div>
