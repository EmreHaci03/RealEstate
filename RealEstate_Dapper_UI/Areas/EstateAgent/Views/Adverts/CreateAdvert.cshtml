@model CreateProductDto
@{
    Layout = "~/Areas/EstateAgent/Views/Shared/_EstateAgentLayout.cshtml";
    ViewData["Title"] = "Yeni İlan";
}

<style>
    .ca-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 24px;
    }

    .ca-section {
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 4px 0 14px;
    }

        .ca-section:not(:first-child) {
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid var(--line);
        }

    .ca-label {
        font-size: .86rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 6px;
    }

    .ca-hint {
        font-size: .78rem;
        color: var(--muted);
        margin-top: 5px;
    }

    .ca-input-icon {
        position: relative;
    }

        .ca-input-icon > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: .85rem;
        }

        .ca-input-icon > .form-control {
            padding-left: 38px;
        }

    .ca-counter {
        font-size: .76rem;
        color: var(--muted);
        text-align: right;
        margin-top: 4px;
    }

    .ca-preview {
        position: sticky;
        top: 90px;
    }

    .ca-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
    }

    .ca-cover {
        position: relative;
        aspect-ratio: 16 / 10;
        background: var(--primary-soft);
        display: grid;
        place-items: center;
        overflow: hidden;
    }

        .ca-cover img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .ca-cover-empty {
        color: var(--primary);
        text-align: center;
        font-size: .85rem;
    }

        .ca-cover-empty i {
            font-size: 30px;
            display: block;
            margin-bottom: 6px;
        }

    .ca-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 1;
        background: rgba(255, 255, 255, .94);
        color: var(--primary);
        font-size: .74rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
    }

    .ca-body {
        padding: 18px;
    }

    .ca-price {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text);
    }

    .ca-title {
        font-weight: 600;
        color: var(--text);
        margin: 4px 0 6px;
        line-height: 1.35;
        word-break: break-word;
    }

    .ca-location {
        font-size: .84rem;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .ca-desc {
        font-size: .84rem;
        color: var(--muted);
        line-height: 1.6;
        white-space: pre-line;
        word-break: break-word;
    }

    .ca-empty-text {
        color: #9ca3af;
        font-style: italic;
    }

    .ca-agent {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 14px;
        margin-top: 14px;
        border-top: 1px solid var(--line);
        font-size: .84rem;
        color: var(--muted);
    }

    .ca-agent-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #059669, #34d399);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: .75rem;
    }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Yeni İlan</h4>
            <p class="mb-0" style="color: var(--muted);">İlan bilgilerini gir, sağ tarafta nasıl görüneceğini anında gör.</p>
        </div>
        <a asp-area="EstateAgent" asp-controller="Adverts" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>İlanlarıma Dön
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- Form -->
        <div class="col-lg-7">
            <form asp-area="EstateAgent" asp-controller="Adverts" asp-action="CreateAdvert" method="post" class="ca-panel">

                <div class="ca-section">Temel Bilgiler</div>

                <div class="mb-3">
                    <label asp-for="Title" class="ca-label">İlan Başlığı</label>
                    <input asp-for="Title" id="inTitle" class="form-control" maxlength="100" placeholder="Örn. Deniz manzaralı 3+1 daire" required />
                    <div class="ca-counter"><span id="titleCount">0</span>/100</div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Category" class="ca-label">Kategori</label>
                        <select asp-for="Category" id="inCategory" class="form-select" asp-items="ViewBag.Categories" required>
                            <option value="">Kategori seç</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="ca-label">Fiyat (₺)</label>
                        <div class="ca-input-icon">
                            <i class="fa fa-lira-sign"></i>
                            <input asp-for="Price" id="inPrice" type="number" min="0" step="1000" class="form-control" placeholder="5000000" required />
                        </div>
                    </div>
                </div>

                <div class="ca-section">Konum</div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="City" class="ca-label">Şehir</label>
                        <input asp-for="City" id="inCity" class="form-control" placeholder="Örn. İzmir" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="District" class="ca-label">İlçe</label>
                        <input asp-for="District" id="inDistrict" class="form-control" placeholder="Örn. Karşıyaka" required />
                    </div>
                    <div class="col-12">
                        <label asp-for="Adress" class="ca-label">Açık Adres</label>
                        <input asp-for="Adress" class="form-control" placeholder="Mahalle, sokak, numara" />
                    </div>
                </div>

                <div class="ca-section">Görsel ve Açıklama</div>

                <div class="mb-3">
                    <label asp-for="CoverImage" class="ca-label">Kapak Resmi (URL)</label>
                    <div class="ca-input-icon">
                        <i class="fa fa-image"></i>
                        <input asp-for="CoverImage" id="inCover" type="url" class="form-control" placeholder="https://..." />
                    </div>
                    <div class="ca-hint">Resmin bağlantısını yapıştır, önizlemede hemen görünür.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="ca-label">Açıklama</label>
                    <textarea asp-for="Description" id="inDesc" rows="5" class="form-control" maxlength="1000" placeholder="İlanın öne çıkan özelliklerini yaz..."></textarea>
                    <div class="ca-counter"><span id="descCount">0</span>/1000</div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-area="EstateAgent" asp-controller="Adverts" asp-action="Index" class="btn btn-light border px-4">Vazgeç</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="fa fa-check me-2"></i>İlanı Yayınla</button>
                </div>
            </form>
        </div>

        <!-- Önizleme -->
        <div class="col-lg-5">
            <div class="ca-preview">
                <div class="ca-section" style="margin-top: 0;">Canlı Önizleme</div>
                <div class="ca-card">
                    <div class="ca-cover">
                        <div class="ca-cover-empty" id="pvCoverEmpty"><i class="fa fa-image"></i>Kapak resmi eklenmedi</div>
                        <img id="pvCover" alt="" style="display: none;" />
                        <span class="ca-badge" id="pvCategory" style="display: none;"></span>
                    </div>
                    <div class="ca-body">
                        <div class="ca-price" id="pvPrice"><span class="ca-empty-text">₺0</span></div>
                        <div class="ca-title" id="pvTitle"><span class="ca-empty-text">İlan başlığı</span></div>
                        <div class="ca-location"><i class="fa fa-map-marker-alt me-1"></i><span id="pvLocation" class="ca-empty-text">İlçe, Şehir</span></div>
                        <div class="ca-desc" id="pvDesc"><span class="ca-empty-text">Açıklama burada görünecek.</span></div>
                        <div class="ca-agent">
                            <div class="ca-agent-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper())</div>
                            <span>Sorumlu danışman: <b style="color: var(--text);">@User.Identity?.Name</b></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var formatter = new Intl.NumberFormat("tr-TR");
            var $ = function (id) { return document.getElementById(id); };

            function setText(el, value, placeholder) {
                if (value && value.trim()) {
                    el.textContent = value;
                } else {
                    el.innerHTML = '<span class="ca-empty-text">' + placeholder + '</span>';
                }
            }

            function update() {
                setText($("pvTitle"), $("inTitle").value, "İlan başlığı");
                setText($("pvDesc"), $("inDesc").value, "Açıklama burada görünecek.");

                var price = parseFloat($("inPrice").value);
                $("pvPrice").textContent = isNaN(price) ? "₺0" : "₺" + formatter.format(price);

                var city = $("inCity").value.trim();
                var district = $("inDistrict").value.trim();
                var location = [district, city].filter(Boolean).join(", ");
                $("pvLocation").textContent = location || "İlçe, Şehir";
                $("pvLocation").className = location ? "" : "ca-empty-text";

                var select = $("inCategory");
                var categoryText = select.value ? select.options[select.selectedIndex].text : "";
                $("pvCategory").textContent = categoryText;
                $("pvCategory").style.display = categoryText ? "" : "none";

                $("titleCount").textContent = $("inTitle").value.length;
                $("descCount").textContent = $("inDesc").value.length;
            }

            // Kapak resmi: yüklenemezse boş durumu göster
            $("inCover").addEventListener("input", function () {
                var url = this.value.trim();
                if (!url) {
                    $("pvCover").style.display = "none";
                    $("pvCoverEmpty").style.display = "";
                    return;
                }
                $("pvCover").onload = function () {
                    $("pvCover").style.display = "";
                    $("pvCoverEmpty").style.display = "none";
                };
                $("pvCover").onerror = function () {
                    $("pvCover").style.display = "none";
                    $("pvCoverEmpty").style.display = "";
                    $("pvCoverEmpty").innerHTML = '<i class="fa fa-exclamation-triangle"></i>Resim yüklenemedi';
                };
                $("pvCover").src = url;
            });

            ["inTitle", "inPrice", "inCity", "inDistrict", "inDesc", "inCategory"].forEach(function (id) {
                $(id).addEventListener("input", update);
                $(id).addEventListener("change", update);
            });

            update();
            if ($("inCover").value) $("inCover").dispatchEvent(new Event("input"));
        });
    </script>
}