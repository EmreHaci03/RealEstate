@model List<RealEstate_Dapper_UI.DTOS.ProductDtos.ResultProductWithDetailDto>
@{
    ViewData["Title"] = "İlanlarım";
    Layout = "~/Areas/EstateAgent/Views/Shared/_EstateAgentLayout.cshtml";

    var tr = new System.Globalization.CultureInfo("tr-TR");
    var totalCount = Model.Count;
    var totalValue = Model.Sum(x => x.Price);
    var averagePrice = totalCount > 0 ? Model.Average(x => x.Price) : 0;
    var cityCount = Model.Select(x => x.City).Distinct().Count();
    var categories = Model.Select(x => x.CategoryName).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();

    string ShortPrice(decimal value) => value >= 1_000_000
        ? "₺" + (value / 1_000_000m).ToString("0.#", tr) + "M"
        : "₺" + value.ToString("N0", tr);
}

<style>
    .adv-stat {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
    }

    .adv-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        font-size: 19px;
        flex-shrink: 0;
    }

    .adv-stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

    .adv-stat-label {
        font-size: .82rem;
        color: var(--muted);
        margin-top: 3px;
    }

    .c-green {
        background: rgba(5, 150, 105, .12);
        color: #059669;
    }

    .c-sky {
        background: rgba(14, 165, 233, .12);
        color: #0284c7;
    }

    .c-amber {
        background: rgba(245, 158, 11, .12);
        color: #d97706;
    }

    .c-violet {
        background: rgba(139, 92, 246, .12);
        color: #7c3aed;
    }

    .adv-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

    .adv-tabs {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 4px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 4px;
    }

    .adv-tab {
        border: 0;
        background: transparent;
        padding: 7px 14px;
        border-radius: 9px;
        font-size: .85rem;
        font-weight: 500;
        color: var(--muted);
    }

        .adv-tab.active {
            background: var(--primary);
            color: #fff;
        }

    .adv-search {
        position: relative;
        max-width: 300px;
        width: 100%;
    }

        .adv-search i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: .85rem;
        }

        .adv-search input {
            padding-left: 38px;
            height: 42px;
        }

    .adv-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .adv-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 36px -20px rgba(16, 24, 40, .35);
        }

    .adv-cover {
        position: relative;
        aspect-ratio: 16 / 10;
        background: var(--primary-soft);
        overflow: hidden;
    }

        .adv-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s ease;
        }

    .adv-card:hover .adv-cover img {
        transform: scale(1.05);
    }

    .adv-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(255, 255, 255, .94);
        color: var(--primary);
        font-size: .74rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
    }

    .adv-id {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(2, 6, 23, .55);
        color: #fff;
        font-size: .72rem;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 999px;
    }

    .adv-body {
        padding: 16px 18px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .adv-price {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text);
    }

    .adv-title {
        font-weight: 600;
        color: var(--text);
        margin: 4px 0 6px;
        line-height: 1.35;
    }

    .adv-location {
        font-size: .82rem;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .adv-desc {
        font-size: .84rem;
        color: var(--muted);
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .adv-address {
        font-size: .78rem;
        color: var(--muted);
        padding-top: 12px;
        border-top: 1px solid var(--line);
        margin-top: auto;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .adv-address i {
            color: var(--primary);
            margin-right: 6px;
        }

    .adv-actions {
        display: flex;
        gap: 8px;
        padding: 0 18px 16px;
    }

        .adv-actions a {
            flex: 1;
            height: 38px;
            border-radius: 10px;
            font-size: .84rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none;
            border: 1px solid var(--line);
            background: var(--surface);
            color: var(--text);
            transition: all .15s ease;
        }

            .adv-actions a:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

    .adv-add {
        height: 100%;
        min-height: 380px;
        border: 2px dashed var(--line);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--muted);
        text-decoration: none;
        transition: all .2s ease;
    }

        .adv-add:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-soft);
        }

        .adv-add i {
            font-size: 28px;
        }

    .adv-empty {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        text-align: center;
        padding: 60px 20px;
    }

    .adv-empty-icon {
        width: 76px;
        height: 76px;
        border-radius: 22px;
        background: var(--primary-soft);
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 30px;
        margin: 0 auto 16px;
    }
</style>

<div class="container-fluid pt-4 px-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1 fw-bold">İlanlarım</h4>
            <p class="mb-0" style="color: var(--muted);">Merhaba @User.Identity?.Name, sorumlu olduğun ilanlar burada.</p>
        </div>
        <a asp-area="EstateAgent" asp-controller="Adverts" asp-action="CreateAdvert" class="btn btn-primary px-4">
            <i class="fa fa-plus me-2"></i>Yeni İlan
        </a>
    </div>

    @if (Model.Any())
    {
        <!-- Özet -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="adv-stat">
                    <div class="adv-stat-icon c-green"><i class="fa fa-home"></i></div>
                    <div><div class="adv-stat-value">@totalCount</div><div class="adv-stat-label">Toplam ilan</div></div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="adv-stat">
                    <div class="adv-stat-icon c-amber"><i class="fa fa-lira-sign"></i></div>
                    <div><div class="adv-stat-value">@ShortPrice(totalValue)</div><div class="adv-stat-label">Portföy değeri</div></div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="adv-stat">
                    <div class="adv-stat-icon c-sky"><i class="fa fa-chart-line"></i></div>
                    <div><div class="adv-stat-value">@ShortPrice(averagePrice)</div><div class="adv-stat-label">Ortalama fiyat</div></div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="adv-stat">
                    <div class="adv-stat-icon c-violet"><i class="fa fa-city"></i></div>
                    <div><div class="adv-stat-value">@cityCount</div><div class="adv-stat-label">Farklı şehir</div></div>
                </div>
            </div>
        </div>

        <!-- Filtre + arama -->
        <div class="adv-toolbar">
            <div class="adv-tabs" role="group" aria-label="Kategoriye göre filtrele">
                <button type="button" class="adv-tab active" data-filter="all">Tümü</button>
                @foreach (var category in categories)
                {
                    <button type="button" class="adv-tab" data-filter="@category.ToLower()">@category</button>
                }
            </div>
            <div class="adv-search">
                <i class="fa fa-search"></i>
                <input type="text" id="advSearch" class="form-control" placeholder="Başlık, şehir veya ilçe ara..." />
            </div>
        </div>

        <!-- İlanlar -->
        <div class="row g-4 mb-4" id="advGrid">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4 adv-item"
                     data-category="@item.CategoryName?.ToLower()"
                     data-search="@($"{item.Title} {item.City} {item.District} {item.CategoryName}".ToLower())">
                    <div class="adv-card">
                        <div class="adv-cover">
                            @if (!string.IsNullOrEmpty(item.CoverImage))
                            {
                                <img src="@item.CoverImage" alt="@item.Title" loading="lazy" />
                            }
                            <span class="adv-badge">@item.CategoryName</span>
                            <span class="adv-id">#@item.ProductId</span>
                        </div>
                        <div class="adv-body">
                            <div class="adv-price">₺@item.Price.ToString("N0", tr)</div>
                            <div class="adv-title">@item.Title</div>
                            <div class="adv-location"><i class="fa fa-map-marker-alt me-1"></i>@item.District, @item.City</div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="adv-desc">@item.Description</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Adress))
                            {
                                <div class="adv-address" title="@item.Adress"><i class="fa fa-road"></i>@item.Adress</div>
                            }
                        </div>
                        <div class="adv-actions">
                            <a asp-area="EstateAgent" asp-controller="Adverts" asp-action="AdvertDetail" asp-route-id="@item.ProductId">
                                <i class="fa fa-eye"></i>Detay
                            </a>
                            <a asp-area="EstateAgent" asp-controller="Adverts" asp-action="UpdateAdvert" asp-route-id="@item.ProductId">
                                <i class="fa fa-pen"></i>Düzenle
                            </a>
                        </div>
                    </div>
                </div>
            }

            <div class="col-md-6 col-xl-4 adv-add-wrap">
                <a asp-area="EstateAgent" asp-controller="Adverts" asp-action="CreateAdvert" class="adv-add">
                    <i class="fa fa-plus-circle"></i>
                    <span class="fw-semibold">Yeni ilan ekle</span>
                    <small>Portföyüne yeni bir mülk ekle</small>
                </a>
            </div>
        </div>

        <div id="advNoResult" class="text-center py-5" style="display: none; color: var(--muted);">
            <i class="fa fa-search fa-2x mb-2" style="color: var(--primary);"></i>
            <div>Aramanla eşleşen ilan bulunamadı.</div>
        </div>
    }
    else
    {
        <div class="adv-empty">
            <div class="adv-empty-icon"><i class="fa fa-home"></i></div>
            <h5 class="fw-bold mb-1">Henüz ilanın yok</h5>
            <p class="mb-4" style="color: var(--muted);">Sana atanmış bir ilan bulunmuyor. İlk ilanını ekleyerek başlayabilirsin.</p>
            <a asp-area="EstateAgent" asp-controller="Adverts" asp-action="CreateAdvert" class="btn btn-primary px-4">
                <i class="fa fa-plus me-2"></i>İlan Ekle
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var searchInput = document.getElementById("advSearch");
            if (!searchInput) return;

            var tabs = document.querySelectorAll(".adv-tab");
            var addCard = document.querySelector(".adv-add-wrap");
            var currentFilter = "all";

            function apply() {
                var term = searchInput.value.trim().toLocaleLowerCase("tr");
                var visible = 0;

                document.querySelectorAll(".adv-item").forEach(function (item) {
                    var matchSearch = item.getAttribute("data-search").toLocaleLowerCase("tr").includes(term);
                    var matchFilter = currentFilter === "all" || item.getAttribute("data-category") === currentFilter;
                    var show = matchSearch && matchFilter;
                    item.style.display = show ? "" : "none";
                    if (show) visible++;
                });

                addCard.style.display = (term === "" && currentFilter === "all") ? "" : "none";
                document.getElementById("advNoResult").style.display = visible === 0 ? "" : "none";
            }

            searchInput.addEventListener("input", apply);

            tabs.forEach(function (tab) {
                tab.addEventListener("click", function () {
                    tabs.forEach(function (t) { t.classList.remove("active"); });
                    this.classList.add("active");
                    currentFilter = this.getAttribute("data-filter");
                    apply();
                });
            });
        });
    </script>
}