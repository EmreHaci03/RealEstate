<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] · Danışman Paneli</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <link href="~/dashmin-1.0.0/img/favicon.ico" rel="icon">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="~/dashmin-1.0.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/dashmin-1.0.0/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #059669;
            --primary-dark: #047857;
            --primary-soft: rgba(5, 150, 105, .10);
            --page-bg: #f4f7f6;
            --surface: #ffffff;
            --line: #e5ebe9;
            --muted: #6b7280;
            --text: #1f2937;
            --radius: 14px;
        }

        body {
            font-family: "Inter", system-ui, sans-serif;
            color: var(--text);
            background: var(--page-bg);
            -webkit-font-smoothing: antialiased;
        }

        .container-xxl {
            max-width: 100%;
            background: var(--page-bg) !important;
        }

        h1, h2, h3, h4, h5, h6 {
            color: var(--text);
            letter-spacing: -.01em;
        }

        .text-primary {
            color: var(--primary) !important;
        }

        a {
            color: var(--primary);
        }

        /* Sidebar */
        .sidebar {
            background: var(--surface);
            border-right: 1px solid var(--line);
        }

            .sidebar .navbar {
                background: transparent !important;
            }

            .sidebar .navbar-brand h3 {
                font-weight: 700;
                font-size: 1.3rem;
            }

        .agent-badge {
            display: inline-block;
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            background: var(--primary-soft);
            color: var(--primary);
            padding: 3px 8px;
            border-radius: 999px;
            margin-left: 6px;
            vertical-align: middle;
        }

        .sidebar .navbar-nav {
            padding: 0 .75rem;
        }

        .sidebar-section {
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 1rem 1rem .4rem;
        }

        .sidebar .navbar .navbar-nav .nav-link {
            color: var(--muted);
            font-weight: 500;
            font-size: .93rem;
            padding: .65rem 1rem;
            margin-bottom: 2px;
            border: 0;
            border-radius: 10px;
            transition: background .15s, color .15s;
        }

            .sidebar .navbar .navbar-nav .nav-link i {
                width: auto;
                height: auto;
                background: transparent !important;
                color: inherit;
                border-radius: 0;
                margin-right: .6rem !important;
            }

            .sidebar .navbar .navbar-nav .nav-link:hover,
            .sidebar .navbar .navbar-nav .nav-link.active {
                background: var(--primary-soft);
                color: var(--primary);
                border: 0;
            }

            .sidebar .navbar .navbar-nav .nav-link.active {
                font-weight: 600;
            }

        .agent-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #059669, #34d399);
            color: #fff;
            display: grid;
            place-items: center;
            font-weight: 700;
            font-size: .9rem;
        }

        /* Üst bar */
        .content .navbar {
            background: rgba(244, 247, 246, .85) !important;
            backdrop-filter: saturate(180%) blur(12px);
            border-bottom: 1px solid var(--line);
            height: 68px;
        }

            .content .navbar .sidebar-toggler,
            .content .navbar .navbar-nav .nav-link i {
                background: transparent !important;
                color: var(--text);
                border-radius: 10px;
            }

                .content .navbar .sidebar-toggler:hover {
                    background: var(--primary-soft) !important;
                }

            .content .navbar .navbar-nav .nav-link {
                color: var(--text);
                font-weight: 500;
                font-size: .9rem;
            }

        .dropdown-menu {
            background: var(--surface) !important;
            border: 1px solid var(--line) !important;
            border-radius: 12px !important;
            box-shadow: 0 12px 32px rgba(16, 24, 40, .10);
            padding: .4rem;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: .55rem .75rem;
        }

            .dropdown-item:hover {
                background: var(--primary-soft);
                color: var(--primary);
            }

        /* Kartlar ve formlar */
        .content .bg-light {
            background: var(--surface) !important;
            border: 1px solid var(--line);
            border-radius: var(--radius) !important;
        }

        .content .navbar.bg-light {
            border-radius: 0 !important;
            border-width: 0 0 1px 0;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
            border-radius: 10px;
            font-weight: 500;
        }

            .btn-primary:hover, .btn-primary:focus {
                background: var(--primary-dark);
                border-color: var(--primary-dark);
            }

        .form-control, .form-select {
            border-radius: 10px;
            border-color: var(--line);
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px var(--primary-soft);
            }

        .form-check-input:checked {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .table {
            --bs-table-bg: transparent;
        }

        .back-to-top {
            background: var(--primary);
            border-color: var(--primary);
            border-radius: 12px;
        }

        #spinner {
            background: var(--page-bg) !important;
        }

            #spinner .spinner-border {
                color: var(--primary) !important;
            }
    </style>


</head>