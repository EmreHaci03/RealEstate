@model List<ResultContactDto>
<div class="col-lg-6 col-xl-4">
    <div class="db-panel">
        <div class="db-panel-head">
            <h6 class="db-panel-title">Son Mesajlar</h6>
            <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="db-panel-link">Gelen kutusu</a>
        </div>
        @foreach (var item in Model.OrderByDescending(x=>x.ContactId).Take(5))
        {
            <div class="db-msg">
                <div class="db-msg-avatar c-indigo">@item.Name.Substring(0,1)</div>
                <div class="flex-grow-1" style="min-width: 0;">
                    <div class="db-msg-top"><span class="db-msg-name">@item.Name</span><span class="db-msg-time">@item.SendDate.ToString("dd MMM yyyy")</span></div>
                    <div class="db-msg-text">@item.Message.</div>
                </div>
            </div>
        }
    </div>
</div>