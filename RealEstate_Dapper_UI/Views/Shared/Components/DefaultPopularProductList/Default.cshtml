@model List<ResultProductDto>

<style>
    .locations-1 .box16 {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
    }

        .locations-1 .box16 img {
            width: 100%;
            height: 100%;
            object-fit: cover; 
            display: block;
            transition: transform .5s ease;
        }

        .locations-1 .box16:hover img {
            transform: scale(1.06);
        }
</style>

<section class="locations-1" id="locations">
    <div class="locations py-5">
        <div class="container py-lg-5 py-md-4 py-2">
            <div class="heading text-center mx-auto">
                <h6 class="title-small">Öne Çıkanlar</h6>
                <h3 class="title-big mt-3">Popüler İlanlar</h3>
            </div>
            <div class="row pt-md-5 pt-4">
                @foreach (var item in Model.OrderByDescending(x => x.ProductId).Take(6))
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <a asp-controller="Property" asp-action="PropertyDetail" 
                           asp-route-id="@item.ProductId">
                            <div class="box16">
                                <div class="rentext-listing-category"><span>@item.CategoryName</span></div>
                                <img src="@item.CoverImage" alt="@item.Title" loading="lazy">
                                <div class="box-content">
                                    <h3 class="title">₺@item.Price.ToString("N0")</h3>
                                    <span class="post">@item.District, @item.City</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>