@model ResultStatisticDto
<div class="ab-stats">
    <div class="ab-stat">
        <i class="fa fa-building"></i>
        <b>@Model.TotalProduct+</b>
        <small>Satılan Mülk</small>
    </div>
    <div class="ab-stat">
        <i class="fa fa-smile-o"></i>
        <b>@Model.ClientCount+</b>
        <small>Mutlu Müşteri</small>
    </div>
    <div class="ab-stat">
        <i class="fa fa-user-circle"></i>
        <b>@Model.TotalEmployee</b>
        <small>Uzman Danışman</small>
    </div>
    <div class="ab-stat">
        <i class="fa fa-map-marker"></i>
        <b>@Model.CityCount</b>
        <small>Hizmet Verilen Şehir</small>
    </div>
</div>