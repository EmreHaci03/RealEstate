@model List<ResultTestimonialDto>

@{
    int TestimonialCount = Model?.Count ?? 0;
}

<style>
    #clients .clients-info .title-big {
        background: linear-gradient(135deg, #1f6feb, #0ea5e9);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    #clients .testimonial {
        position: relative;
        background: var(--x-surface, #fff);
        border: 1px solid rgba(15, 23, 42, .08);
        border-radius: 20px;
        padding: 28px 26px 24px;
        box-shadow: 0 10px 30px -14px rgba(15, 23, 42, .25);
    }

        #clients .testimonial .quote-icon {
            position: absolute;
            top: 20px;
            right: 24px;
            font-size: 34px;
            color: rgba(31, 111, 235, .15);
        }

    #clients .testi-des {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
    }

    #clients .client-avatar {
        flex-shrink: 0;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 17px;
        letter-spacing: .02em;
        color: #fff;
        background: linear-gradient(135deg, #1f6feb, #0ea5e9);
        box-shadow: 0 8px 18px -8px rgba(31, 111, 235, .7);
    }

    #clients .peopl h4 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
    }

    #clients .peopl .indentity {
        margin: 2px 0 0;
        font-size: 13px;
        opacity: .7;
    }

    #clients .client-stars {
        color: #f5b301;
        font-size: 13px;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    #clients .testimonial blockquote {
        margin: 0;
        padding: 0;
        border: none;
    }

    #clients .testimonial q {
        quotes: none;
        font-size: 15.5px;
        line-height: 1.7;
        font-style: italic;
    }
</style>

<section class="w3l-index3" id="clients">
    <div class="midd-w3 py-5">
        <div class="container pb-lg-5 pb-md-4 pb-2">
            <div class="row">
                <div class="col-lg-5 pr-lg-0">
                    <div class="w3l-left-img1">
                    </div>
                </div>
                <div class="col-lg-7 pl-lg-0">
                    <div class="w3l-right-info">
                        <h6 class="title-small">Müşterilerimiz</h6>
                        <div class="client-grid">
                            <div class="client-title">
                                <h3 class="title-big">Müşteri ilişkilerine değer veriyoruz</h3>
                            </div>
                            <div class="clients-info">
                                <h3 class="title-big">@TestimonialCount+</h3>
                                <p>Mutlu müşteri</p>
                            </div>
                        </div>

                        <div class="w3l-clients" id="testimonials">
                            <div id="owl-demo1" class="owl-carousel owl-theme mt-4 pt-2 mb-4">
                                @foreach (var item in Model)
                                {
                                    var parts = (item.NameSurname ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                    var initials = string.Concat(parts.Take(2).Select(p => p[0])).ToUpper();

                                    <div class="item">
                                        <div class="testimonial-content">
                                            <div class="testimonial">
                                                <span class="fa fa-quote-right quote-icon" aria-hidden="true"></span>
                                                <div class="testi-des">
                                                    <div class="client-avatar">@initials</div>
                                                    <div class="peopl align-self">
                                                        <h4>@item.NameSurname</h4>
                                                        <p class="indentity">@item.Title</p>
                                                    </div>
                                                </div>
                                                <div class="client-stars" aria-label="5 üzerinden 5 yıldız">
                                                    <span class="fa fa-star"></span>
                                                    <span class="fa fa-star"></span>
                                                    <span class="fa fa-star"></span>
                                                    <span class="fa fa-star"></span>
                                                    <span class="fa fa-star"></span>
                                                </div>
                                                <blockquote>
                                                    <q>@item.Comment</q>
                                                </blockquote>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <a href="#agents" class="btn btn-style btn-primary mt-5">Danışmanlarımızla iletişime geçin</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>