@model List<ResultProductCountByCityDto>

<style>
    .popular .box16 {
        position: relative;
        aspect-ratio: 1 / 1; /* şehir kartları kare */
        overflow: hidden;
    }

        .popular .box16 img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .5s ease;
        }

        .popular .box16:hover img {
            transform: scale(1.06);
        }
</style>

<section class="locations-1 popular" id="popular-locations">
    <div class="locations py-5">
        <div class="container py-lg-5 py-md-4">
            <div class="heading text-center mx-auto">
                <h6 class="title-small">Şehirleri Keşfet</h6>
                <h3 class="title-big mt-3">Popüler Lokasyonlar</h3>
            </div>
            <div class="row pt-5">
                @foreach (var item in Model)
                {
                    <div class="col-lg-3 col-md-4 col-6 mb-4">
                        <a asp-controller="Property" asp-action="PropertySearch" asp-route-city="@item.City">
                            <div class="box16">
                                <img src="@item.CoverImage" alt="@item.City" loading="lazy">
                                <div class="box-content">
                                    <h3 class="title mb-1">@item.City</h3>
                                    <span class="post">@item.ProductCount ilan</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>