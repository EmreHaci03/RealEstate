@model List<ResultFeatureCardDto>

<section class="w3l-bottom-grids py-5" id="steps-2">
    <div class="container py-lg-5 py-md-4 py-2">
        <div class="grids-area-hny main-cont-wthree-fea row">
            @foreach (var item in Model.OrderByDescending(x=>x.FeatureCardId).Take(3))
            {
                <div class="col-lg-4 col-md-6 grids-feature mb-4">
                    <div class="area-box no-box-shadow text-left">
                        <span class="@item.Icon"></span>
                        <h5>@item.SubTitle</h5>
                        <h4><a href="@item.ButtonUrl" class="title-head">@item.Title</a></h4>
                        <p>@item.Description</p>
                        <a href="@item.ButtonUrl" class="more">@item.ButtonText <span class="fa fa-long-arrow-right"></span></a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>