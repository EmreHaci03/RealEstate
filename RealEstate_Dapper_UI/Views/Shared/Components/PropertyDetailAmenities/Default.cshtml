@model List<ResultAmenityPropertyDto>

<div class="pd-panel">
    <div class="pd-panel-title">
        <i class="fa fa-star"></i>Olanaklar
        <span class="am-count">@Model.Count olanak</span>
    </div>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6 mb-3">
                <div class="am-item">
                    <span class="am-icon"><i class="fa fa-check-circle"></i></span>
                    <span class="am-name">@item.Amenity</span>
                    <i class="fa fa-check am-check"></i>
                </div>
            </div>
        }
    </div>
</div>