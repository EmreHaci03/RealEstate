@{
    Layout = null;
    Context.Response.StatusCode = 404;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sayfa Bulunamadı · Emlak Satış</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Inter", system-ui, sans-serif;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            color: #1f2937;
            background: radial-gradient(circle at 15% 20%, rgba(79, 70, 229, .12), transparent 40%), radial-gradient(circle at 85% 80%, rgba(14, 165, 233, .12), transparent 40%), #f8fafc;
        }

        .wrap {
            width: 100%;
            max-width: 560px;
            text-align: center;
        }

        .scene {
            position: relative;
            height: 220px;
            margin-bottom: 8px;
        }

        .code {
            font-size: clamp(6rem, 22vw, 10rem);
            font-weight: 800;
            line-height: 1;
            letter-spacing: -.05em;
            background: linear-gradient(135deg, #4f46e5, #0ea5e9);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            opacity: .18;
            user-select: none;
        }

        .house {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 120px;
            height: 120px;
            border-radius: 32px;
            background: #fff;
            box-shadow: 0 24px 50px -20px rgba(79, 70, 229, .45);
            display: grid;
            place-items: center;
            animation: float 3.5s ease-in-out infinite;
        }

            .house i {
                font-size: 52px;
                color: #4f46e5;
            }

            .house .search {
                position: absolute;
                right: -14px;
                bottom: -10px;
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: linear-gradient(135deg, #f59e0b, #f97316);
                color: #fff;
                display: grid;
                place-items: center;
                font-size: 20px;
                box-shadow: 0 10px 20px -8px rgba(249, 115, 22, .6);
            }

        @@keyframes float {
            0%, 100% {
                transform: translate(-50%, -50%);
            }

            50% {
                transform: translate(-50%, calc(-50% - 10px));
            }
        }

        h1 {
            font-size: clamp(1.5rem, 4vw, 2rem);
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -.02em;
        }

        p {
            color: #6b7280;
            line-height: 1.65;
            margin-bottom: 28px;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            margin-bottom: 32px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 48px;
            padding: 0 22px;
            border-radius: 14px;
            font-weight: 600;
            font-size: .95rem;
            text-decoration: none;
            transition: transform .15s ease, box-shadow .2s ease, background .2s ease;
        }

            .btn:active {
                transform: scale(.98);
            }

        .btn-primary {
            background: #4f46e5;
            color: #fff;
            box-shadow: 0 12px 24px -12px rgba(79, 70, 229, .7);
        }

            .btn-primary:hover {
                background: #4338ca;
            }

        .btn-light {
            background: #fff;
            color: #1f2937;
            border: 1px solid #e5e7eb;
        }

            .btn-light:hover {
                border-color: #4f46e5;
                color: #4f46e5;
            }

        .links {
            border-top: 1px solid #e5e7eb;
            padding-top: 22px;
        }

            .links span {
                display: block;
                font-size: .82rem;
                color: #9ca3af;
                margin-bottom: 12px;
            }

            .links nav {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                justify-content: center;
            }

            .links a {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 8px 14px;
                border-radius: 999px;
                background: rgba(79, 70, 229, .08);
                color: #4f46e5;
                font-size: .85rem;
                font-weight: 500;
                text-decoration: none;
                transition: background .2s ease;
            }

                .links a:hover {
                    background: rgba(79, 70, 229, .16);
                }

        @@media (prefers-reduced-motion: reduce) {
            .house {
                animation: none;
            }
        }
    </style>
</head>
<body>
    <main class="wrap">
        <div class="scene" aria-hidden="true">
            <div class="code">404</div>
            <div class="house">
                <i class="fa fa-home"></i>
                <div class="search"><i class="fa fa-search" style="font-size: 18px; color: #fff;"></i></div>
            </div>
        </div>

        <h1>Aradığın sayfa burada değil</h1>
        <p>
            Bu adreste bir sayfa bulamadık. Taşınmış, kaldırılmış ya da adres yanlış yazılmış olabilir.
            Ama merak etme, hayalindeki evi bulmana yardım edebiliriz.
        </p>

        <div class="actions">
            <a asp-area="" asp-controller="Default" asp-action="Index" class="btn btn-primary">
                <i class="fa fa-home"></i>Ana Sayfaya Dön
            </a>
            <a href="javascript:history.back()" class="btn btn-light">
                <i class="fa fa-arrow-left"></i>Geri Git
            </a>
        </div>

        <div class="links">
            <span>Belki bunlara bakmak istersin</span>
            <nav>
                <a asp-area="" asp-controller="Default" asp-action="Index" asp-fragment="locations"><i class="fa fa-building"></i>İlanlar</a>
                <a asp-area="" asp-controller="Default" asp-action="Index" asp-fragment="popular-locations"><i class="fa fa-map-marker-alt"></i>Popüler Lokasyonlar</a>
                <a asp-area="" asp-controller="Default" asp-action="Index" asp-fragment="agents"><i class="fa fa-user-tie"></i>Danışmanlar</a>
                <a asp-area="" asp-controller="Contact" asp-action="Index"><i class="fa fa-envelope"></i>İletişim</a>
            </nav>
        </div>
    </main>
</body>
</html>