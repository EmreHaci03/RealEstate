@{
    ViewData["Title"] = "Giriş Gerekli";
    Layout = "~/Views/Shared/UI_Layout.cshtml";
}

<style>
    .er-page {
        --er-accent: #f15a24;
        --er-soft: rgba(241, 90, 36, .1);
        --er-text: #1f2937;
        --er-muted: #6b7280;
        --er-line: #e8eaee;
        background: #f7f8fa;
        padding: 90px 0;
    }

    .er-box {
        max-width: 560px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid var(--er-line);
        border-radius: 22px;
        padding: 50px 40px;
        text-align: center;
        box-shadow: 0 30px 60px -40px rgba(17, 24, 39, .35);
    }

    .er-icon {
        width: 96px;
        height: 96px;
        border-radius: 28px;
        background: var(--er-soft);
        color: var(--er-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 22px;
    }

    .er-code {
        display: inline-block;
        font-size: .8rem;
        font-weight: 800;
        letter-spacing: .12em;
        color: var(--er-accent);
        background: var(--er-soft);
        padding: 5px 14px;
        border-radius: 999px;
        margin-bottom: 14px;
    }

    .er-box h1 {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--er-text);
        margin-bottom: 10px;
    }

    .er-box p {
        color: var(--er-muted);
        line-height: 1.7;
        margin-bottom: 28px;
    }

    .er-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }

    .er-btn {
        display: inline-flex;
        align-items: center;
        height: 48px;
        padding: 0 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s;
    }

        .er-btn .fa {
            margin-right: 8px;
        }

    .er-btn-primary {
        background: var(--er-accent);
        color: #fff;
    }

        .er-btn-primary:hover {
            color: #fff;
            text-decoration: none;
            filter: brightness(.92);
        }

    .er-btn-light {
        background: #fff;
        color: var(--er-text);
        border: 1px solid var(--er-line);
    }

        .er-btn-light:hover {
            color: var(--er-accent);
            border-color: var(--er-accent);
            text-decoration: none;
        }
</style>

<div class="er-page">
    <div class="container">
        <div class="er-box">
            <div class="er-icon"><i class="fa fa-lock"></i></div>
            <span class="er-code">HATA 401</span>
            <h1>Giriş Yapmanız Gerekiyor</h1>
            <p>Bu sayfayı görüntüleyebilmek için hesabınıza giriş yapmalısınız. Hesabınız yoksa bizimle iletişime geçebilirsiniz.</p>
            <div class="er-actions">
                <a asp-controller="Account" asp-action="Index" class="er-btn er-btn-primary"><i class="fa fa-sign-in"></i>Giriş Yap</a>
                <a asp-controller="Default" asp-action="Index" class="er-btn er-btn-light"><i class="fa fa-home"></i>Ana Sayfa</a>
            </div>
        </div>
    </div>
</div>