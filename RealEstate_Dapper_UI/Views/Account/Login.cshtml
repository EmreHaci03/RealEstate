@model ResultLoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Giriş Yap</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Inter", sans-serif;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, #eef2ff, #f5f6fa);
            padding: 20px;
        }

        .card {
            width: 100%;
            max-width: 400px;
            background: #fff;
            border-radius: 20px;
            padding: 36px 32px;
            box-shadow: 0 24px 60px -24px rgba(16, 24, 40, .25);
        }

        h2 {
            font-size: 1.5rem;
            margin-bottom: 6px;
            color: #1f2937;
        }

        .sub {
            color: #6b7280;
            margin-bottom: 26px;
            font-size: .92rem;
        }

        label {
            display: block;
            font-size: .85rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #1f2937;
        }

        input {
            width: 100%;
            height: 46px;
            padding: 0 14px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            font: inherit;
            margin-bottom: 18px;
        }

            input:focus {
                outline: none;
                border-color: #4f46e5;
                box-shadow: 0 0 0 4px rgba(79, 70, 229, .12);
            }

        button {
            width: 100%;
            height: 46px;
            border: 0;
            border-radius: 12px;
            background: #4f46e5;
            color: #fff;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }

            button:hover {
                background: #4338ca;
            }

        .error {
            padding: 12px 14px;
            border-radius: 12px;
            background: rgba(244, 63, 94, .1);
            color: #e11d48;
            font-size: .88rem;
            margin-bottom: 18px;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Giriş Yap</h2>
        <p class="sub">Devam etmek için hesabınıza giriş yapın.</p>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <label for="Username">Kullanıcı Adı</label>
            <input asp-for="Username" id="Username" required autocomplete="username" />

            <label for="Password">Şifre</label>
            <input asp-for="Password" id="Password" type="password" required autocomplete="current-password" />

            <button type="submit">Giriş Yap</button>
        </form>
    </div>
</body>
</html>