@model RealEstate_Dapper_UI.DTOS.ProductDetailDtos.GetProductDetailByIdDto
@{
    var title = string.IsNullOrWhiteSpace(Model.Product) ? "İlan Detayı" : Model.Product;
    ViewData["Title"] = title;
    Layout = "~/Views/Shared/UI_Layout.cshtml";

    var tr = new System.Globalization.CultureInfo("tr-TR");
    var hasData = Model.ProductDetailId > 0;

    // Galeri: şimdilik örnek görseller. İleride kapak resmi / galeri eklersen bu listeyi oradan doldurman yeterli.
    var images = ViewBag.Images as List<string> ?? new List<string>();
    if (!images.Any())
        images.Add("https://picsum.photos/seed/noimage/1200/800");

    string? EmbedUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        if (url.Contains("/embed/")) return url;
        if (url.Contains("watch?v=")) return "https://www.youtube.com/embed/" + url.Split("watch?v=")[1].Split('&')[0];
        if (url.Contains("youtu.be/")) return "https://www.youtube.com/embed/" + url.Split("youtu.be/")[1].Split('?')[0];
        return null;
    }

    var videoEmbed = EmbedUrl(Model.VideoUrl);
    var hasLocation = !string.IsNullOrWhiteSpace(Model.Location);
}

<style>
    .pd-page {
        --pd-accent: #f15a24;
        --pd-accent-soft: rgba(241, 90, 36, .1);
        --pd-text: #1f2937;
        --pd-muted: #6b7280;
        --pd-line: #e8eaee;
        --pd-bg: #f7f8fa;
        background: var(--pd-bg);
        padding-bottom: 60px;
    }

    /* Üst bilgi */
    .pd-top {
        background: #fff;
        border-bottom: 1px solid var(--pd-line);
        padding: 28px 0 24px;
    }

    .pd-crumb {
        font-size: .86rem;
        color: var(--pd-muted);
        margin-bottom: 14px;
    }

        .pd-crumb a {
            color: var(--pd-muted);
            text-decoration: none;
        }

            .pd-crumb a:hover {
                color: var(--pd-accent);
            }

    .pd-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
    }

    .pd-badge {
        display: inline-block;
        background: var(--pd-accent-soft);
        color: var(--pd-accent);
        font-size: .76rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
        margin-bottom: 10px;
    }

    .pd-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--pd-text);
        margin: 0 0 8px;
        line-height: 1.25;
    }

    .pd-loc {
        color: var(--pd-muted);
        font-size: .95rem;
    }

        .pd-loc .fa {
            color: var(--pd-accent);
            margin-right: 6px;
        }

    .pd-price-box {
        text-align: right;
        margin-top: 12px;
    }

        .pd-price-box small {
            display: block;
            color: var(--pd-muted);
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .pd-price-box b {
            font-size: 2rem;
            color: var(--pd-accent);
            font-weight: 700;
        }

    /* Slider */
    .pd-slider {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        background: #111827;
        margin-top: 28px;
        box-shadow: 0 24px 50px -28px rgba(17, 24, 39, .5);
    }

    .pd-track {
        display: flex;
        transition: transform .5s cubic-bezier(.22, .61, .36, 1);
    }

    .pd-slide {
        min-width: 100%;
        position: relative;
        padding-top: 58%;
    }

        .pd-slide img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pd-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 0;
        background: rgba(255, 255, 255, .92);
        color: var(--pd-text);
        font-size: 1.3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(0, 0, 0, .2);
        transition: background .2s, color .2s, transform .2s;
        z-index: 2;
    }

        .pd-nav:hover {
            background: var(--pd-accent);
            color: #fff;
        }

        .pd-nav:focus {
            outline: none;
            box-shadow: 0 0 0 3px var(--pd-accent-soft);
        }

    .pd-prev {
        left: 18px;
    }

    .pd-next {
        right: 18px;
    }

    .pd-counter {
        position: absolute;
        right: 18px;
        bottom: 18px;
        z-index: 2;
        background: rgba(17, 24, 39, .7);
        color: #fff;
        font-size: .82rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 999px;
    }

    .pd-dots {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 20px;
        display: flex;
        justify-content: center;
        z-index: 2;
    }

    .pd-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        border: 0;
        background: rgba(255, 255, 255, .55);
        margin: 0 4px;
        padding: 0;
        transition: width .3s, background .3s;
    }

        .pd-dot.active {
            width: 24px;
            background: #fff;
        }

    .pd-thumbs {
        display: flex;
        margin-top: 12px;
        overflow-x: auto;
        padding-bottom: 4px;
    }

    .pd-thumb {
        flex: 0 0 auto;
        width: 110px;
        height: 74px;
        border-radius: 12px;
        overflow: hidden;
        border: 3px solid transparent;
        margin-right: 10px;
        padding: 0;
        background: none;
        opacity: .65;
        transition: opacity .2s, border-color .2s;
    }

        .pd-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .pd-thumb:hover {
            opacity: 1;
        }

        .pd-thumb.active {
            border-color: var(--pd-accent);
            opacity: 1;
        }

        .pd-thumb:focus {
            outline: none;
        }

    /* Hızlı özellik şeridi */
    .pd-facts {
        display: flex;
        flex-wrap: wrap;
        background: #fff;
        border: 1px solid var(--pd-line);
        border-radius: 18px;
        margin-top: 24px;
        overflow: hidden;
    }

    .pd-fact {
        flex: 1 1 140px;
        padding: 18px;
        text-align: center;
        border-right: 1px solid var(--pd-line);
    }

        .pd-fact:last-child {
            border-right: 0;
        }

        .pd-fact .fa {
            font-size: 20px;
            color: var(--pd-accent);
            margin-bottom: 6px;
            display: block;
        }

        .pd-fact b {
            display: block;
            font-size: 1.2rem;
            color: var(--pd-text);
        }

        .pd-fact small {
            color: var(--pd-muted);
            font-size: .78rem;
        }

    /* Paneller */
    .pd-panel {
        background: #fff;
        border: 1px solid var(--pd-line);
        border-radius: 18px;
        padding: 26px;
        margin-top: 24px;
    }

    .pd-panel-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--pd-text);
        margin-bottom: 18px;
        display: flex;
        align-items: center;
    }

        .pd-panel-title .fa {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--pd-accent-soft);
            color: var(--pd-accent);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: .95rem;
        }

    .pd-desc {
        color: var(--pd-muted);
        line-height: 1.85;
        white-space: pre-line;
        margin: 0;
    }

    .pd-spec {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px dashed var(--pd-line);
        font-size: .93rem;
    }

        .pd-spec span {
            color: var(--pd-muted);
        }

        .pd-spec b {
            color: var(--pd-text);
            font-weight: 600;
        }

    .pd-media {
        position: relative;
        padding-top: 56.25%;
        border-radius: 14px;
        overflow: hidden;
        background: var(--pd-bg);
    }

        .pd-media iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

    /* Yan kart */
    .pd-side {
        position: sticky;
        top: 100px;
    }

    .pd-agent {
        background: #fff;
        border: 1px solid var(--pd-line);
        border-radius: 18px;
        padding: 26px;
        margin-top: 24px;
        text-align: center;
    }

    .pd-agent-avatar {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--pd-accent), #fb923c);
        color: #fff;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        box-shadow: 0 0 0 6px var(--pd-accent-soft);
    }

    .pd-agent h5 {
        font-weight: 700;
        color: var(--pd-text);
        margin-bottom: 2px;
    }

    .pd-agent > small {
        color: var(--pd-muted);
    }

    .pd-agent-price {
        background: var(--pd-bg);
        border-radius: 14px;
        padding: 14px;
        margin: 18px 0;
    }

        .pd-agent-price small {
            display: block;
            color: var(--pd-muted);
            font-size: .78rem;
        }

        .pd-agent-price b {
            font-size: 1.5rem;
            color: var(--pd-text);
        }

    .pd-btn {
        display: block;
        width: 100%;
        height: 50px;
        line-height: 50px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 10px;
        transition: all .2s;
    }

    .pd-btn-primary {
        background: var(--pd-accent);
        color: #fff;
    }

        .pd-btn-primary:hover {
            color: #fff;
            text-decoration: none;
            filter: brightness(.92);
        }

    .pd-btn-light {
        background: #fff;
        border: 1px solid var(--pd-line);
        color: var(--pd-text);
        line-height: 48px;
    }

        .pd-btn-light:hover {
            border-color: var(--pd-accent);
            color: var(--pd-accent);
            text-decoration: none;
        }

    .pd-share {
        display: flex;
        justify-content: center;
        margin-top: 8px;
    }

        .pd-share button {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid var(--pd-line);
            background: #fff;
            color: var(--pd-muted);
            margin: 0 4px;
            transition: all .2s;
        }

            .pd-share button:hover {
                border-color: var(--pd-accent);
                color: var(--pd-accent);
            }

    .pd-copied {
        font-size: .8rem;
        color: var(--pd-accent);
        margin-top: 8px;
        display: none;
    }

    .pd-empty {
        background: #fff;
        border: 1px solid var(--pd-line);
        border-radius: 18px;
        text-align: center;
        padding: 70px 20px;
        margin-top: 40px;
    }

    .pd-empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 24px;
        background: var(--pd-accent-soft);
        color: var(--pd-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 16px;
    }

    @@media (max-width: 767px) {
        .pd-title {
            font-size: 1.5rem;
        }

        .pd-price-box {
            text-align: left;
        }

        .pd-nav {
            width: 40px;
            height: 40px;
        }

        .pd-thumb {
            width: 86px;
            height: 60px;
        }

        .pd-fact {
            flex-basis: 33%;
            border-bottom: 1px solid var(--pd-line);
        }
    }
</style>

<div class="pd-page">
    @if (!hasData)
    {
        <div class="container">
            <div class="pd-empty">
                <div class="pd-empty-icon"><i class="fa fa-home"></i></div>
                <h4 style="font-weight: 700;">İlan bulunamadı</h4>
                <p style="color: var(--pd-muted);">Aradığınız ilan kaldırılmış ya da detay bilgileri henüz eklenmemiş olabilir.</p>
                <a asp-controller="Property" asp-action="PropertyList" class="btn btn-style btn-primary mt-2">Tüm İlanlar</a>
            </div>
        </div>
    }
    else
    {
        <!-- Başlık -->
        <section class="pd-top">
            <div class="container">
                <div class="pd-crumb">
                    <a asp-controller="Default" asp-action="Index">Ana Sayfa</a>
                    <span class="mx-2">/</span>
                    <a asp-controller="Property" asp-action="PropertyList">İlanlar</a>
                    <span class="mx-2">/</span>
                    <span>@title</span>
                </div>
                <div class="pd-head">
                    <div>
                        <span class="pd-badge">@Model.ProductSize m² · @Model.RoomCount oda</span>
                        <h1 class="pd-title">@title</h1>
                        @if (hasLocation)
                        {
                            <div class="pd-loc"><i class="fa fa-map-marker"></i>@Model.Location</div>
                        }
                    </div>
                    <div class="pd-price-box">
                        <small>Fiyat</small>
                        <b>₺@Model.Price.ToString("N0", tr)</b>
                    </div>
                </div>
            </div>
        </section>

        <div class="container">
            <div class="row">
                <!-- Sol -->
                <div class="col-lg-8">

                    <!-- Slider -->
                    <div class="pd-slider" id="pdSlider" tabindex="0" aria-roledescription="carousel" aria-label="İlan fotoğrafları">
                        <div class="pd-track" id="pdTrack">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <div class="pd-slide" aria-label="@(i + 1) / @images.Count">
                                    <img src="@images[i]" alt="@title - fotoğraf @(i + 1)" @(i == 0 ? "" : "loading=lazy") />
                                </div>
                            }
                        </div>
                        <button type="button" class="pd-nav pd-prev" id="pdPrev" aria-label="Önceki fotoğraf"><i class="fa fa-angle-left"></i></button>
                        <button type="button" class="pd-nav pd-next" id="pdNext" aria-label="Sonraki fotoğraf"><i class="fa fa-angle-right"></i></button>
                        <div class="pd-dots" id="pdDots">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <button type="button" class="pd-dot @(i == 0 ? "active" : "")" data-index="@i" aria-label="@(i + 1). fotoğraf"></button>
                            }
                        </div>
                        <div class="pd-counter"><i class="fa fa-camera mr-1"></i><span id="pdCurrent">1</span> / @images.Count</div>
                    </div>

                    <div class="pd-thumbs" id="pdThumbs">
                        @for (var i = 0; i < images.Count; i++)
                        {
                            <button type="button" class="pd-thumb @(i == 0 ? "active" : "")" data-index="@i" aria-label="@(i + 1). fotoğrafa git">
                                <img src="@images[i]" alt="" loading="lazy" />
                            </button>
                        }
                    </div>

                    <!-- Hızlı özellikler -->
                    <div class="pd-facts">
                        <div class="pd-fact"><i class="fa fa-arrows-alt"></i><b>@Model.ProductSize m²</b><small>Alan</small></div>
                        <div class="pd-fact"><i class="fa fa-th-large"></i><b>@Model.RoomCount</b><small>Oda</small></div>
                        <div class="pd-fact"><i class="fa fa-bed"></i><b>@Model.BedRoomCount</b><small>Yatak Odası</small></div>
                        <div class="pd-fact"><i class="fa fa-bath"></i><b>@Model.BathCount</b><small>Banyo</small></div>
                        <div class="pd-fact"><i class="fa fa-car"></i><b>@Model.GarageSize</b><small>Garaj</small></div>
                        <div class="pd-fact"><i class="fa fa-calendar"></i><b>@Model.BuildYear</b><small>Yapım Yılı</small></div>
                    </div>

                    <!-- Özellik tablosu -->
                    <div class="pd-panel">
                        <div class="pd-panel-title"><i class="fa fa-list-ul"></i>İlan Bilgileri</div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="pd-spec"><span>İlan No</span><b>#@Model.ProductDetailId</b></div>
                                <div class="pd-spec"><span>Fiyat</span><b>₺@Model.Price.ToString("N0", tr)</b></div>
                                <div class="pd-spec"><span>Metrekare</span><b>@Model.ProductSize m²</b></div>
                                <div class="pd-spec"><span>Oda Sayısı</span><b>@Model.RoomCount</b></div>
                            </div>
                            <div class="col-md-6">
                                <div class="pd-spec"><span>Yatak Odası</span><b>@Model.BedRoomCount</b></div>
                                <div class="pd-spec"><span>Banyo</span><b>@Model.BathCount</b></div>
                                <div class="pd-spec"><span>Garaj</span><b>@Model.GarageSize</b></div>
                                <div class="pd-spec"><span>Yapım Yılı</span><b>@Model.BuildYear</b></div>
                            </div>
                        </div>
                    </div>

                    <!-- Video -->
                    @if (videoEmbed != null)
                    {
                        <div class="pd-panel">
                            <div class="pd-panel-title"><i class="fa fa-play-circle"></i>Tanıtım Videosu</div>
                            <div class="pd-media">
                                <iframe src="@videoEmbed" title="Tanıtım videosu" loading="lazy"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                            </div>
                        </div>
                    }

                    <!-- Harita -->
                    @if (hasLocation)
                    {
                        <div class="pd-panel">
                            <div class="pd-panel-title"><i class="fa fa-map-marker"></i>Konum</div>
                            <p style="color: var(--pd-muted); margin-bottom: 14px;"><i class="fa fa-map-pin mr-2" style="color: var(--pd-accent);"></i>@Model.Location</p>
                            <div class="pd-media">
                                <iframe src="https://maps.google.com/maps?q=@Uri.EscapeDataString(Model.Location!)&output=embed" title="Konum" loading="lazy"></iframe>
                            </div>
                        </div>
                    }
                </div>

                <!-- Sağ -->
                <div class="col-lg-4">
                    <div class="pd-side">
                        <div class="pd-agent">
                            <div class="pd-agent-avatar"><i class="fa fa-user"></i></div>
                            <h5>@ViewBag.EmployeeName</h5>
                            <h5>@ViewBag.EmployeeMail</h5>
                            <small>Bu ilanla ilgili bilgi almak için bize ulaşın</small>

                            <div class="pd-agent-price">
                                <small>Fiyat</small>
                                <b>₺@Model.Price.ToString("N0", tr)</b>
                            </div>

                            <a asp-controller="Contact" asp-action="Index" class="pd-btn pd-btn-primary">
                                <i class="fa fa-envelope mr-2"></i>Danışmana Mesaj Gönder
                            </a>
                            <a asp-controller="Property" asp-action="GetPropertyListByUser" asp-route-id="@ViewBag.EmployeeId" class="pd-btn pd-btn-light">
                                <i class="fa fa-th mr-2"></i>Danışmanın Diğer İlanları
                            </a>

                            <div class="pd-share">
                                <button type="button" id="pdCopy" title="Bağlantıyı kopyala" aria-label="Bağlantıyı kopyala"><i class="fa fa-link"></i></button>
                                <button type="button" id="pdWhatsapp" title="WhatsApp'ta paylaş" aria-label="WhatsApp'ta paylaş"><i class="fa fa-whatsapp"></i></button>
                                <button type="button" onclick="window.print()" title="Yazdır" aria-label="Yazdır"><i class="fa fa-print"></i></button>
                            </div>
                            <div class="pd-copied" id="pdCopied">Bağlantı kopyalandı!</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>document.addEventListener("DOMContentLoaded", function () {
        var track = document.getElementById("pdTrack");
        if (!track) return;

        var slider = document.getElementById("pdSlider");
        var dots = document.querySelectorAll("#pdDots .pd-dot");
        var thumbs = document.querySelectorAll("#pdThumbs .pd-thumb");
        var total = track.children.length;
        var current = 0;
        var autoTimer = null;

        function goTo(index) {
            current = (index + total) % total;
            track.style.transform = "translateX(-" + (current * 100) + "%)";
            document.getElementById("pdCurrent").textContent = current + 1;

            dots.forEach(function (d, i) { d.classList.toggle("active", i === current); });
            thumbs.forEach(function (t, i) { t.classList.toggle("active", i === current); });

            // Aktif küçük resmi görünür alana kaydır
            var activeThumb = thumbs[current];
            if (activeThumb) activeThumb.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        }

        function startAuto() {
            stopAuto();
            autoTimer = setInterval(function () { goTo(current + 1); }, 5000);
        }

        function stopAuto() {
            if (autoTimer) clearInterval(autoTimer);
        }

        document.getElementById("pdPrev").addEventListener("click", function () { goTo(current - 1); startAuto(); });
        document.getElementById("pdNext").addEventListener("click", function () { goTo(current + 1); startAuto(); });

        dots.forEach(function (d) {
            d.addEventListener("click", function () { goTo(parseInt(this.getAttribute("data-index"))); startAuto(); });
        });
        thumbs.forEach(function (t) {
            t.addEventListener("click", function () { goTo(parseInt(this.getAttribute("data-index"))); startAuto(); });
        });

        // Klavye ile gezinme
        slider.addEventListener("keydown", function (e) {
            if (e.key === "ArrowLeft") { goTo(current - 1); startAuto(); }
            if (e.key === "ArrowRight") { goTo(current + 1); startAuto(); }
        });

        // Mobilde kaydırma
        var startX = 0;
        slider.addEventListener("touchstart", function (e) { startX = e.touches[0].clientX; stopAuto(); }, { passive: true });
        slider.addEventListener("touchend", function (e) {
            var diff = e.changedTouches[0].clientX - startX;
            if (Math.abs(diff) > 50) goTo(diff < 0 ? current + 1 : current - 1);
            startAuto();
        });

        // Fare üzerindeyken otomatik geçişi durdur
        slider.addEventListener("mouseenter", stopAuto);
        slider.addEventListener("mouseleave", startAuto);

        startAuto();

        // Paylaşım
        document.getElementById("pdCopy").addEventListener("click", function () {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href).then(function () {
                    var msg = document.getElementById("pdCopied");
                    msg.style.display = "block";
                    setTimeout(function () { msg.style.display = "none"; }, 2000);
                });
            }
        });
        document.getElementById("pdWhatsapp").addEventListener("click", function () {
            var text = encodeURIComponent(document.title + " - " + window.location.href);
            window.open("https://wa.me/?text=" + text, "_blank");
        });
    });</script>
